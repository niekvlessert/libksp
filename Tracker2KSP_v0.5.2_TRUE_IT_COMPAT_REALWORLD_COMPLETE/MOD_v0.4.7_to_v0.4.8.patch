+def _mod_swap16(blob:bytes)->bytes:
+    if len(blob)%2: blob+=b'\0'
+    out=bytearray(len(blob))
+    for i in range(0,len(blob),2): out[i],out[i+1]=blob[i+1],blob[i]
+    return bytes(out)
