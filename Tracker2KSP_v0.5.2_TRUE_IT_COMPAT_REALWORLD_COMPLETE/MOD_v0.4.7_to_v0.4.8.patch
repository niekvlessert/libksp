+        call mod_shr_hl_a
+        ld de,(GLISS_ACC)
+        add hl,de
+        ld (GLISS_ACC),hl
+        ld hl,(GLISS_TMP)
+        ld a,8
+        call mod_shr_hl_a
+        ex de,hl
+        ld hl,(GLISS_ACC)
+        or a
+        sbc hl,de
+        ld (GLISS_ACC),hl
+        ld hl,(GLISS_TMP)
+        ld a,10
+        call mod_shr_hl_a
+        ld de,(GLISS_ACC)
+        add hl,de
+        ret
+
+mod_shr_hl_a:
+        or a
+        ret z
+mod_shr_hl_loop:
+        srl h
+        rr l
+        dec a
+        jr nz,mod_shr_hl_loop
+        ret
+
+effect_vibrato:
+        ; ProTracker does not apply or advance vibrato on tick 0.
+        ld a,(TICK_NOW)
+        or a
+        ret z
+        ld hl,VIBPH
+        call ptr8_cur
+        ld a,(hl)
+        and 3Fh
+        ld c,a
+        ld hl,VIBWAVE
+        call ptr8_cur
+        ld b,(hl)
+        call mod_wave_delta       ; signed A
+        ld c,a
+        or a
+        jr z,mod_vib_advance
+        jp p,mod_vib_positive
+        neg
+        ld b,1
+        jr mod_vib_abs
+mod_vib_positive:
+        ld b,0
+mod_vib_abs:
+        ld e,a
+        ld d,0
+        push bc
+        ld hl,VIBDEP
+        call ptr8_cur
+        ld a,(hl)
+        ld c,a
+        ld hl,0
+mod_vib_mul:
+        ld a,c
+        or a
+        jr z,mod_vib_mul_done
+        add hl,de
+        dec c
+        jr mod_vib_mul
+mod_vib_mul_done:
+        ; delta * depthNibble / 16 in quarter-period units.
+        srl h
+        rr l
+        srl h
+        rr l
+        srl h
+        rr l
+        srl h
+        rr l
+        ex de,hl
+        pop bc
+        ld hl,(OUT_PERIOD)
+        ld a,b
+        or a
+        jr nz,mod_vib_sub
+        add hl,de
+        jr mod_vib_store
+mod_vib_sub:
+        or a
+        sbc hl,de
+        jr nc,mod_vib_store
+        ld hl,1
+mod_vib_store:
+        ld (OUT_PERIOD),hl
+        ld a,d
+        or e
+        jr z,mod_vib_advance
+        ld a,1
+        ld (PITCH_DIRTY),a
+mod_vib_advance:
+        ld hl,VIBSPD
+        call ptr8_cur
+        ld b,(hl)
+        ld hl,VIBPH
+        call ptr8_cur
+        ld a,(hl)
+        add a,b
+        and 3Fh
+        ld (hl),a
+        ret
+
+; Input A=phase 0..63, B=waveform 0..7. Output signed A.
+; bit2 only controls phase reset and is ignored for shape selection.
+mod_wave_delta:
+        ld c,a
+        ld a,b
+        and 03h
+        jr z,mod_wave_sine
+        cp 1
+        jr z,mod_wave_ramp
+        cp 2
+        jr z,mod_wave_square
+        ; deterministic ProTracker random table
+        ld e,c
+        ld d,0
+        ld hl,MOD_RANDOM_TABLE
+        add hl,de
+        ld a,(hl)
+        ret
+mod_wave_sine:
+        ld e,c
+        ld d,0
+        ld hl,SINE_TABLE
+        add hl,de
+        ld a,(hl)
+        ret
+mod_wave_ramp:
+        ; MOD vibrato ramp is the inverted legacy ramp used by OpenMPT.
+        ld a,c
+        cp 32
+        jr nc,mod_wave_ramp_neg
+        add a,a
+        add a,a
+        ret
+mod_wave_ramp_neg:
+        add a,a
+        add a,a
+        cpl
+        inc a
+        inc a                    ; -(255 - phase*4)
+        ret
+mod_wave_square:
+        ld a,c
+        cp 32
+        ld a,127
+        ret c
+        ld a,129                 ; -127
+        ret
+
+; OpenMPT compatibility for multichannel/M!K! MODs: FT2's tremolo ramp
+; implementation accidentally depends on vibrato phase. Input C=tremolo phase,
+; output signed A.
+mod_ft2_trem_ramp:
+        ld a,c
+        add a,a
+        add a,a
+        and 07Fh
+        ld e,a                    ; ramp magnitude
+        ; If vibrato is active this row, FT2 tests the advanced vibrato phase.
+        ld a,0
+        ld hl,CMD1
+        call ptr8_cur
+        ld a,(hl)
+        cp CMD_H
+        jr z,mod_ft2_trem_has_vib
+        ld hl,CMD2
+        call ptr8_cur
+        ld a,(hl)
+        cp CMD_H
+        jr nz,mod_ft2_trem_vib_phase
+mod_ft2_trem_has_vib:
+        ld hl,VIBSPD
+        call ptr8_cur
+        ld a,(hl)
+        ld d,a
+        jr mod_ft2_trem_vib_load
+mod_ft2_trem_vib_phase:
+        ld d,0
+mod_ft2_trem_vib_load:
+        ld hl,VIBPH
+        call ptr8_cur
+        ld a,(hl)
+        add a,d
+        and 03Fh
+        cp 32
+        jr c,mod_ft2_trem_no_xor
+        ld a,e
+        xor 07Fh
+        ld e,a
+mod_ft2_trem_no_xor:
+        ld a,c
+        and 03Fh
+        cp 32
+        ld a,e
+        ret c
+        neg
+        ret
+
+effect_mod_tremolo:
+        ld a,(TICK_NOW)
+        or a
+        ret z
+        ld hl,TREMPH
+        call ptr8_cur
+        ld a,(hl)
+        and 3Fh
+        ld c,a
+        ld hl,TREMWAVE
+        call ptr8_cur
+        ld b,(hl)
+        ld a,b
+        and 03h
+        cp 1
+        jr nz,mod_trem_regular_wave
+        ld a,(MOD_FLAGS)
+        bit 1,a
+        jr z,mod_trem_regular_wave
+        call mod_ft2_trem_ramp
+        jr mod_trem_wave_done
+mod_trem_regular_wave:
+        ld a,c
+        call mod_wave_delta
+mod_trem_wave_done:
+        ld c,a
+        or a
+        jr z,mod_trem_emit_base
+        jp p,mod_trem_positive
+        neg
+        ld b,1
+        jr mod_trem_abs
+mod_trem_positive:
+        ld b,0
+mod_trem_abs:
+        ld e,a
+        ld d,0
+        push bc
+        ld hl,TREMDEP
+        call ptr8_cur
+        ld a,(hl)
+        ld c,a
+        ld hl,0
+mod_trem_mul:
+        ld a,c
+        or a
+        jr z,mod_trem_mul_done
+        add hl,de
+        dec c
+        jr mod_trem_mul
+mod_trem_mul_done:
+        ; Convert OpenMPT's internal tremolo to our 0..64 volume domain:
+        ; delta * depthNibble / 32.
+        srl h
+        rr l
+        srl h
+        rr l
+        srl h
+        rr l
+        srl h
+        rr l
+        srl h
+        rr l
+        ld e,l
+        pop bc
+        ld hl,VOLUME
+        call ptr8_cur
+        ld a,(hl)
+        ld d,a
+        ld a,b
+        or a
+        ld a,d
+        jr nz,mod_trem_sub
+        add a,e
+        cp 65
+        jr c,mod_trem_emit
+        ld a,64
+        jr mod_trem_emit
+mod_trem_sub:
+        cp e
+        jr nc,mod_trem_sub_ok
+        xor a
+        jr mod_trem_emit
+mod_trem_sub_ok:
+        sub e
+        jr mod_trem_emit
+mod_trem_emit_base:
+        ld hl,VOLUME
+        call ptr8_cur
+        ld a,(hl)
+mod_trem_emit:
+        push af
+        ld hl,TREMSPD
+        call ptr8_cur
+        ld b,(hl)
+        ld hl,TREMPH
+        call ptr8_cur
+        ld a,(hl)
+        add a,b
+        and 3Fh
+        ld (hl),a
+        pop af
+        jp emit_volume_a
+
+effect_mod_invert:
+        ; EFx sets the ongoing funk speed. The compiler already translates the
+        ; nibble through ProTracker's ModEFxTable (0,5,6,...,128).
+        ld a,e
+        ld hl,EFX_SPEED
+        call ptr8_cur
+        ld (hl),a
+        ld a,(TICK_NOW)
+        or a
+        ret nz
+        jp mod_invert_tick
+
+; ProTracker EFx / invert-loop. Mutate the active custom-wave payload directly
+; in MoonSound RAM at tracker tick cadence, matching Paula's in-place sample XOR.
+mod_invert_tick:
+        ld hl,EFX_SPEED
+        call ptr8_cur
+        ld a,(hl)
+        or a
+        ret z
+        ld b,a
+        ld hl,EFX_DELAY
+        call ptr8_cur
+        ld a,(hl)
+        add a,b
+        cp 128
+        jr nc,mod_invert_due
+        ld (hl),a
+        ret
+mod_invert_due:
+        xor a
+        ld (hl),a
+
+        ; Read seven-byte OPL4 custom-wave header at 200000h + wave*12.
+        ld hl,WAVE
+        call ptr8_cur
+        ld a,(hl)
+        and 07Fh
+        ld l,a
+        ld h,0
+        add hl,hl               ; *2
+        ld d,h
+        ld e,l
+        add hl,hl               ; *4
+        add hl,de               ; *6
+        add hl,hl               ; *12
+        ld a,h
+        ld (EFX_ADDR+1),a
+        ld a,l
+        ld (EFX_ADDR+2),a
+        ld a,020h
+        ld (EFX_ADDR),a
+        ld d,02h
+        ld e,011h
+        call opl4_write_de
+        call efx_set_mem_addr
+        ld a,006h
+        out (07Eh),a
+        call opl4_wait
+        ld hl,EFX_HDR
+        ld b,7
+mod_invert_hdr_read:
+        in a,(07Fh)
+        ld (hl),a
+        inc hl
+        djnz mod_invert_hdr_read
+
+        ; loop_len = (-endComplement) - loopStart. Non-looped OPL4 aliases
+        ; use a one-byte silent tail; do not funk those.
+        ld a,(EFX_HDR+5)
+        cpl
+        ld h,a
+        ld a,(EFX_HDR+6)
+        cpl
+        ld l,a
+        inc hl                   ; HL = play_len
+        ld a,(EFX_HDR+3)
+        ld d,a
+        ld a,(EFX_HDR+4)
+        ld e,a
+        or a
+        sbc hl,de
+        ld (EFX_LOOPLEN),hl
+        ld a,h
+        or a
+        jr nz,mod_invert_have_loop
+        ld a,l
+        cp 2
+        jr c,mod_invert_disable
+mod_invert_have_loop:
+        ; ++offset; wrap at loop length (PT increments before touching byte).
+        ld hl,EFX_OFFSET
+        call ptr16_cur
+        ld e,(hl)
+        inc hl
+        ld d,(hl)
+        inc de
+        push hl
+        ld hl,(EFX_LOOPLEN)
+        ex de,hl                 ; HL=offset, DE=looplen
+        or a
+        sbc hl,de
+        jr c,mod_invert_offset_ok_sub
+        ld hl,0
+        jr mod_invert_offset_store
+mod_invert_offset_ok_sub:
+        add hl,de                ; restore offset
+mod_invert_offset_store:
+        ex de,hl                 ; DE=offset
+        pop hl                   ; points at high byte of EFX_OFFSET
+        ld (hl),d
+        dec hl
+        ld (hl),e
+
+        ; Physical payload address = header.start + loopStart + offset.
+        ld a,(EFX_HDR+4)
+        add a,e
+        ld l,a
+        ld a,(EFX_HDR+3)
+        adc a,d
+        ld h,a                   ; HL = loopStart + offset
+        ld a,(EFX_HDR+2)
+        add a,l
+        ld (EFX_ADDR+2),a
+        ld a,(EFX_HDR+1)
+        adc a,h
+        ld (EFX_ADDR+1),a
+        ld a,(EFX_HDR)
+        adc a,0
+        and 03Fh
+        ld (EFX_ADDR),a
+
+        ; Read byte, complement it, reset address (read auto-increments), write back.
+        call efx_set_mem_addr
+        ld a,006h
+        out (07Eh),a
+        call opl4_wait
+        in a,(07Fh)
+        cpl
+        ld c,a
+        call efx_set_mem_addr
+        ld a,006h
+        out (07Eh),a
+        call opl4_wait
+        ld a,c
+        out (07Fh),a
+mod_invert_disable:
+        ld d,02h
+        ld e,010h
+        jp opl4_write_de
+
+; Program OPL4 external-memory pointer from EFX_ADDR high/mid/low.
+efx_set_mem_addr:
+        ld d,03h
+        ld a,(EFX_ADDR)
+        ld e,a
+        call opl4_write_de
+        ld d,04h
+        ld a,(EFX_ADDR+1)
+        ld e,a
+        call opl4_write_de
+        ld d,05h
+        ld a,(EFX_ADDR+2)
+        ld e,a
+        jp opl4_write_de
+
+effect_mod_fine_vol_up:
+        ld a,(TICK_NOW)
+        or a
+        ret nz
+        ld a,e
+        and 0Fh
+        or a
+        ret z
+        jp volume_add_a
+
+effect_mod_fine_vol_down:
+        ld a,(TICK_NOW)
+        or a
+        ret nz
+        ld a,e
+        and 0Fh
+        or a
+        ret z
+        jp volume_sub_a
+
+
+MOD_RANDOM_TABLE:
+        db 98,129,213,88,102,41,191,162,125,20,185,170,186,224,240,160
+        db 17,72,107,251,116,187,194,216,10,195,65,109,238,218,243,180
+        db 233,88,21,162,8,106,21,144,6,109,20,168,226,9,129,118
+        db 42,222,89,252,205,184,21,227,112,123,84,155,164,98,202,161
+mod_clamp_period_hl:
+        ; Exact ProTracker finetune-dependent Amiga bounds used by OpenMPT:
+        ; low=max(tuned[B-3]/2,113*4), high=tuned[C-1]*2.
+        ld a,(MOD_FLAGS)
+        bit 0,a
+        ret z
+        push hl
+        ld hl,MOD_FINETUNE
+        call ptr8_cur
+        ld a,(hl)
+        and 0Fh
+        add a,a
+        ld e,a
+        ld d,0
+        ld hl,MOD_LIMIT_LOW
+        add hl,de
+        ld c,(hl)
+        inc hl
+        ld b,(hl)
+        pop hl
+        push hl
+        or a
+        sbc hl,bc
+        pop hl
+        jr nc,mod_clamp_exact_high
+        ld h,b
+        ld l,c
+        ret
+mod_clamp_exact_high:
+        push hl
+        ld hl,MOD_FINETUNE
+        call ptr8_cur
+        ld a,(hl)
+        and 0Fh
+        add a,a
+        ld e,a
+        ld d,0
+        ld hl,MOD_LIMIT_HIGH
+        add hl,de
+        ld c,(hl)
+        inc hl
+        ld b,(hl)
+        pop hl
+        push hl
+        or a
+        sbc hl,bc
+        pop hl
+        ret c
+        ret z
+        ld h,b
+        ld l,c
+        ret
+
+MOD_LIMIT_LOW:
+        dw 453,452,452,452,452,452,452,452,480,477,474,470,467,463,460,457
+MOD_LIMIT_HIGH:
+        dw 3424,3400,3376,3352,3328,3304,3280,3256,3628,3600,3576,3548,3524,3500,3472,3448
+
+effect_mod_fine_up:
+        ld a,(TICK_NOW)
+        or a
+        ret nz
+        ld a,e
+        and 0Fh
+        or a
+        ret z
+        ld l,a
+        ld h,0
+        add hl,hl
+        add hl,hl
+        ex de,hl
+        ld hl,PERIOD_Q
+        call ptr16_cur
+        ld c,(hl)
+        inc hl
+        ld b,(hl)
+        ld h,b
+        ld l,c
+        or a
+        sbc hl,de
+        jr nc,mod_fine_up_nonzero
+        ld hl,1
+mod_fine_up_nonzero:
+        ld a,h
+        or l
+        jr nz,mod_fine_up_store
+        inc hl
+mod_fine_up_store:
+        jp store_period_hl
+
+effect_mod_fine_down:
+        ld a,(TICK_NOW)
+        or a
+        ret nz
+        ld a,e
+        and 0Fh
+        or a
+        ret z
+        ld l,a
+        ld h,0
+        add hl,hl
+        add hl,hl
+        ex de,hl
+        ld hl,PERIOD_Q
+        call ptr16_cur
+        ld c,(hl)
+        inc hl
+        ld b,(hl)
+        ld h,b
+        ld l,c
+        add hl,de
+        jr nc,mod_fine_down_store
+        ld hl,0FFFFh
+mod_fine_down_store:
+        jp store_period_hl
+
+
+
+; ---------------------------------------------------------------------------
+; Relocated MOD parser/runtime helpers. Kept after the legacy pitch LUT/state
+; boundary so the historical LUT addresses remain stable.
+; ---------------------------------------------------------------------------
+mod_parse_instr_state:
+        ld a,e
+        and 0Fh
+        ld hl,MOD_FINETUNE
+        call ptr8_cur
+        ld (hl),a
+        ld hl,EFX_OFFSET
+        call ptr16_cur
+        xor a
+        ld (hl),a
+        inc hl
+        ld (hl),a
+        or a
+        ret
+
+mod_parse_finetune_state:
+        ld a,e
+        and 0Fh
+        ld hl,MOD_FINETUNE
+        call ptr8_cur
+        ld (hl),a
+        or a
+        ret
+
+do_porta_swap:
+        call do_porta_target
+        ; fall through: target changes, active sample changes without pitch reset
+do_sample_swap:
+        ld a,(EV_TONE)
+        ld b,a
+        and 07Fh
+        ld hl,WAVE
+        call ptr8_cur
+        ld (hl),a
+        add a,080h
+        ld e,a
+        ld a,(CUR_CH)
+        add a,008h
+        ld d,a
+        call opl4_write_de
+        bit 7,b
+        ret z
+        ld hl,KEYSTATE
+        call ptr8_cur
+        ld a,(hl)
+        or a
+        ret nz
+        jp keyon_current
--- /dev/null	2026-08-22 15:00:37.378126536 +0000
+++ tests/test_mod_v048.py	2026-08-22 17:29:40.569963831 +0000
@@ -0,0 +1,173 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import tempfile
+import module_formats as mf
+import compact_stream as cs
+import _s3m2opl4_backend as core
+import tracker2ksp as t2k
+
+ROOT=Path(__file__).resolve().parents[1]
+
+def make_mod(path:Path, sig=b'M.K.', channels=4, pattern_bytes=None, sample1_len=0, sample_payload=b'', restart=0, orders=None, sample1_loop_words=1):
+    h=bytearray(1084)
+    h[:20]=b'MOD v0.4.8 test'.ljust(20,b'\0')
+    # 31 sample headers
+    if sample1_len:
+        o=20
+        h[o:o+8]=b'Sample01'
+        h[o+22:o+24]=(sample1_len//2).to_bytes(2,'big')
+        h[o+25]=64
+        h[o+28:o+30]=(sample1_loop_words).to_bytes(2,'big')
+    orders=[0] if orders is None else list(orders)
+    h[950]=min(128,len(orders)); h[951]=restart; h[952:952+len(orders[:128])]=bytes(orders[:128]); h[1080:1084]=sig
+    if pattern_bytes is None:
+        physical_ch=4 if sig in (b'FLT8',b'EXO8') else channels
+        physical_patterns=2 if sig in (b'FLT8',b'EXO8') else 1
+        pattern_bytes=bytes(64*physical_ch*4*physical_patterns)
+    path.write_bytes(h+pattern_bytes+sample_payload)
+
+
+def mod_cell(period=0, ins=0, eff=0, param=0):
+    return bytes((((ins&0xF0)|((period>>8)&0x0F)),period&0xFF,((ins&0x0F)<<4)|(eff&0x0F),param&0xFF))
+
+def pattern4(rows):
+    data=bytearray()
+    for r in range(64):
+        row=rows.get(r,{})
+        for ch in range(4): data += row.get(ch,mod_cell())
+    return bytes(data)
+
+def test_effect_mapping_and_memory(tmp):
+    p=tmp/'a.mod'; make_mod(p)
+    m=mf.parse_mod(p); c=cs.CompactCompiler(m,'MOD'); st=cs.ResolveState()
+    assert mf._mod_effect(1,0xE1)[0:2]==(cs.CMD_F,0xE1)
+    assert c._resolve(st,cs.CMD_F,0xE1)==0xE1
+    assert c._resolve(st,cs.CMD_F,0)==0                 # 1xx has no memory
+    assert c._resolve(st,cs.CMD_D,0x34)==0x34
+    assert c._resolve(st,cs.CMD_D,0)==0                 # Axy has no memory
+    assert c._resolve(st,cs.CMD_G,0x12)==0x12
+    assert c._resolve(st,cs.CMD_G,0)==0x12              # 3xx does
+    assert c._resolve(st,cs.CMD_H,0x34)==0x34
+    assert c._resolve(st,cs.CMD_H,0x05)==0x35           # nibble memory
+    assert c._resolve(st,cs.CMD_O,0x22)==0x22
+    assert c._resolve(st,cs.CMD_O,0)==0x22              # 9xx memory
+    assert mf._mod_effect(0xE,0x1A)[0:2]==(cs.CMD_MOD_FINE_UP,0x0A)
+    assert mf._mod_effect(0xE,0x2B)[0:2]==(cs.CMD_MOD_FINE_DOWN,0x0B)
+    assert mf._mod_effect(0xE,0x31)[0]==cs.CMD_MOD_GLISS
+    assert mf._mod_effect(0xE,0x42)[0]==cs.CMD_MOD_VIBWAVE
+    assert mf._mod_effect(0xE,0x53)[0]==cs.CMD_MOD_FINETUNE
+    assert mf._mod_effect(0xE,0x64)[0]==cs.CMD_MOD_PATLOOP
+    assert mf._mod_effect(0xE,0x75)[0]==cs.CMD_MOD_TREMWAVE
+    assert mf._mod_effect(0xE,0x86)[0]==cs.CMD_MOD_PAN4
+    assert mf._mod_effect(0xE,0xEA)[0]==cs.CMD_MOD_PATDELAY
+    assert mf._mod_effect(0xE,0xF7)[0]==cs.CMD_MOD_INVERT
+    assert cs.MOD_EFX_SPEED[1]==5 and cs.MOD_EFX_SPEED[15]==128
+    assert mf._mod_effect(0xF,0x1F)[0]==cs.CMD_A
+    assert mf._mod_effect(0xF,0x20)[0]==cs.CMD_T
+    assert mf._mod_effect(0xF,0x40,vblank=True)[0:2]==(cs.CMD_A,0x40)
+    assert mf._mod_effect(0xF,0x40,vblank=True,startrekker=True)[0:2]==(cs.CMD_A,31)
+
+def test_exact_periods(tmp):
+    p=tmp/'period.mod'; make_mod(p)
+    m=mf.parse_mod(p)
+    # Add a real sample metadata object so _mod_period can use its native finetune.
+    smp=core.Sample(1,'s',2,0,2,64,0,8363,0,b'\0\0'); smp.mod_finetune=0
+    m.samples[1]=smp
+    c=cs.CompactCompiler(m,'MOD')
+    assert mf._mod_note_index(428)==48
+    assert c._mod_period(1,48,0)==428
+    assert c._mod_period(1,48,1)==425
+    assert c._mod_period(1,36,0)==856
+
+def test_signatures_and_flt8(tmp):
+    p=tmp/'flt8.mod'; make_mod(p,b'FLT8',8)
+    m=mf.parse_mod(p)
+    assert m.mod_profile=='STARTREKKER' and len(m.active_channels)==8
+    assert len(m.patterns)==1 and len(m.patterns[0])==64
+    assert m.mod_vblank and m.mod_startrekker
+    p2=tmp/'32.mod'; make_mod(p2,b'32CH',32)
+    try: mf.parse_mod(p2)
+    except ValueError as e: assert 'at most 24' in str(e)
+    else: raise AssertionError('32-channel MOD was not rejected')
+
+def test_adpcm_and_profiles(tmp):
+    # 8 output bytes: delta table[1]=+1; nibbles all 1 => 1..8.
+    p=tmp/'adpcm.mod'; table=bytes([0,1]+[0]*14); packed=bytes([0x11]*4)
+    make_mod(p,b'M.K.',4,sample1_len=8,sample_payload=b'ADPCM'+table+packed)
+    m=mf.parse_mod(p)
+    assert m.mod_adpcm and m.samples[1].data[:8]==bytes(range(1,9))
+    assert m.mod_pt_mode and m.mod_sample_swap and m.mod_out_of_range_delay
+    # Generic multichannel profile must not inherit strict PT-mode timing.
+    q=tmp/'8chn.mod'; make_mod(q,b'8CHN',8)
+    mg=mf.parse_mod(q)
+    assert mg.mod_profile=='GENERIC_MOD' and not mg.mod_pt_mode
+
+def test_sample_swap_and_one_shot(tmp):
+    # Four consecutive instrument-only changes enable OpenMPT's MOD sample-swap quirk.
+    rows={0:{0:mod_cell(ins=1)},1:{0:mod_cell(ins=2)},2:{0:mod_cell(ins=3)},3:{0:mod_cell(ins=4)},4:{0:mod_cell(ins=5)}}
+    p=tmp/'swap.mod'; make_mod(p,b'M.K.',4,pattern_bytes=pattern4(rows))
+    m=mf.parse_mod(p)
+    assert m.mod_sample_swap_detected and m.mod_sample_swap
+
+    # Canonical PT loop-at-zero is a one-shot tail followed by the original loop.
+    q=tmp/'oneshot.mod'
+    payload=bytes(range(8))
+    make_mod(q,b'M.K.',4,sample1_len=8,sample_payload=payload,sample1_loop_words=2,restart=0)
+    mo=mf.parse_mod(q)
+    assert mo.mod_one_shot_loops and mo.samples[1].loop_begin==0 and mo.samples[1].loop_end==4
+    v=core.WaveVariant(core.WaveKey(1,0),384,'s',8)
+    out,lp,end=t2k.variant_payload(mo,v)
+    assert out==payload+payload[:4] and lp==8 and end==12
+
+def test_vblank_probe(tmp):
+    # Ambiguous M.K.: speed 31 followed by low CIA tempo 32. Repeated orders make
+    # the CIA interpretation >8 min, while VBlank speed interpretation is shorter.
+    rows={0:{0:mod_cell(eff=0xF,param=0x1F)},1:{0:mod_cell(eff=0xF,param=0x20)}}
+    p=tmp/'vblank.mod'; make_mod(p,b'M.K.',4,pattern_bytes=pattern4(rows),orders=[0]*128)
+    m=mf.parse_mod(p)
+    assert m.mod_vblank and m.mod_profile=='PROTRACKER_VBLANK'
+    assert m.mod_cia_duration_probe>=480 and m.mod_vblank_duration_probe < m.mod_cia_duration_probe
+    # F20 is remapped to speed in VBlank mode.
+    ev=[e for e in m.patterns[0][1] if e.ch==0][0]
+    assert ev.cmd==cs.CMD_A and ev.param==0x20
+
+def test_finetune_limits_and_swap_stream():
+    mp=(ROOT/'source/compact_engine_mod.map').read_text().lower()
+    assert 'mod_finetune = 0x5f64' in mp and 'efx_speed = 0x5f7c' in mp
+    asm=(ROOT/'source/compact_engine_mod.asm').read_text().lower()
+    assert 'dw 453,452,452,452,452,452,452,452,480,477,474,470,467,463,460,457' in asm
+    assert 'dw 3424,3400,3376,3352,3328,3304,3280,3256,3628,3600,3576,3548,3524,3500,3472,3448' in asm
+    assert 'mod_invert_tick:' in asm and 'in a,(07fh)' in asm and 'out (07fh),a' in asm
+    # 0x83 is variable-length sample-swap note kind and must carry its wave byte.
+    a=cs.Action(0,note_kind='sample_swap',tone=0x85)
+    enc=cs.CompactCompiler._encode_action(None,a)
+    assert enc[0]&0x20 and enc[1:3]==bytes((0x83,0x85))
+
+def test_engine_layout():
+    mp=(ROOT/'source/compact_engine_mod.map').read_text().lower()
+    expected={'sine_table':'0x4a6c','vol_lut':'0x4ab0','ft2_vib_tab':'0x4af1','pitch_lut':'0x4b11','pitch_lut_end':'0x5f63'}
+    for name,val in expected.items(): assert f'{name} = {val}' in mp, (name,val)
+    # Extended code must remain below the semantic stream window.
+    syms={}
+    for line in mp.splitlines():
+        if ' = 0x' in line:
+            k,v=line.split(' = '); syms[k]=int(v,16)
+    assert syms['effect_mod_fine_down'] < 0x6A00
+    assert syms['do_sample_swap'] < 0x6A00
+    assert (ROOT/'source/compact_engine_mod.bin').stat().st_size <= 0x2A00
+    assert syms['pitch_lut_end']==0x5F63 and syms['mod_finetune']==0x5F64
+
+def main():
+    with tempfile.TemporaryDirectory() as td:
+        tmp=Path(td)
+        test_effect_mapping_and_memory(tmp)
+        test_exact_periods(tmp)
+        test_signatures_and_flt8(tmp)
+        test_adpcm_and_profiles(tmp)
+        test_sample_swap_and_one_shot(tmp)
+        test_vblank_probe(tmp)
+    test_finetune_limits_and_swap_stream()
+    test_engine_layout()
+    print('PASS 8 MOD v0.4.8 generic regression groups')
+
+if __name__=='__main__': main()
