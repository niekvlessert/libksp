+#!/usr/bin/env python3
+from pathlib import Path
+import struct, sys, tempfile
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'source'))
+import module_formats as mf
+import compact_stream as cs
+import tracker2ksp as t2k
+from test_it_v049 import make_it_instrumentmode
+
+INS_PTR=0xD8
+PAT_PTR=0x380
+
+
+def _write_env(buf:bytearray, off:int, flags:int, points, loop=(0,0), sustain=(0,0)):
+    rec=bytearray(82)
+    rec[:6]=bytes((flags&0x1F,len(points)&0xFF,loop[0]&0xFF,loop[1]&0xFF,sustain[0]&0xFF,sustain[1]&0xFF))
+    p=6
+    for x,y in points:
+        rec[p]=y&0xFF
+        struct.pack_into('<H',rec,p+1,x)
+        p+=3
+    buf[off:off+82]=rec
+
+
+def make_it_profile(path:Path, *, nna=0,dct=0,dca=0,fade=0,
+                    vol_env=None,pan_env=None,pitch_env=None, pattern=None):
+    make_it_instrumentmode(path)
+    b=bytearray(path.read_bytes())
+    b[INS_PTR+0x11:INS_PTR+0x14]=bytes((nna,dct,dca))
+    struct.pack_into('<H',b,INS_PTR+0x14,fade)
+    if vol_env:
+        _write_env(b,INS_PTR+0x130,*vol_env)
+    if pan_env:
+        _write_env(b,INS_PTR+0x182,*pan_env)
+    if pitch_env:
+        _write_env(b,INS_PTR+0x1D4,*pitch_env)
+    if pattern is not None:
+        need=PAT_PTR+8+len(pattern)
+        if len(b)<need:b.extend(b'\0'*(need-len(b)))
+        b[PAT_PTR:PAT_PTR+8+len(pattern)]=struct.pack('<HHI',len(pattern),4,0)+pattern
+    path.write_bytes(b)
+
+
+def _event(note=0x40, instrument=1, ch=0):
+    e=mf.core.Event(ch=ch,note=note)
+    e.it_instrument_present=bool(instrument)
+    e.it_instrument_number=instrument
+    e.it_note_special=None
+    return e
+
+
+def test_it_profile_patch_envelopes_and_fadeout(tmp_path):
+    p=tmp_path/'env.it'
+    make_it_profile(
+        p,nna=3,dct=2,dca=1,fade=256,
+        vol_env=(0x07,[(0,64),(2,32),(4,0)],(0,1),(1,2)),
+        pan_env=(0x03,[(0,-32),(2,0),(4,32)],(0,2),(0,0)),
+        pitch_env=(0x01,[(0,24),(1,0),(2,-24)],(0,0),(0,0)),
+    )
+    m,fmt=mf.parse_module(p)
+    assert fmt=='IT' and len(m.it_profiles)==2
+    inst=m.it_instruments[1]
+    assert (inst['nna'],inst['dct'],inst['dca'],inst['fadeout'])==(3,2,1,256)
+    assert inst['vol_env']['flags']==0x07
+    info=t2k.build_it_profile_patch(m,t2k.IT_ENGINE_SYM)
+    assert info and info['profiles']==2 and info['data_addr']+len(info['blob'])<=info['limit']
+    rec=info['blob'][44:88]
+    assert tuple(rec[:6])==(7,3,1,3,2,1)
+    assert struct.unpack_from('<H',rec,6)[0]==256
+    # Pitch curve for +24 half-semitone units is period * 0.5.
+    pitch_ptr=struct.unpack_from('<H',rec,32)[0]
+    pitch_off=pitch_ptr-info['data_addr']
+    assert info['blob'][pitch_off:pitch_off+2]==bytes((128,1))
+    # -24 is one octave down: exactly double period.
+    assert info['blob'][pitch_off+4:pitch_off+6]==bytes((0,2))
+
+
+def test_it_note_off_cut_fade_are_distinct(tmp_path):
+    p=tmp_path/'special.it'
+    pdata=bytes((
+        0x81,0x03,48,1,0,
+        0x81,0x01,255,0,
+        0x81,0x01,254,0,
+        0x81,0x01,253,0,
+    ))
+    make_it_profile(p,fade=64,pattern=pdata)
+    m,fmt=mf.parse_module(p)
+    specials=[m.patterns[0][r][0].it_note_special for r in range(4)]
+    assert specials==[None,'off','cut','fade']
+    cc=cs.CompactCompiler(m,fmt,max_seconds=1)
+    acts=[]
+    for r in range(4):
+        e=m.patterns[0][r][0]
+        a=cc._event_action(e,cc.states[0])
+        if a: acts.append(a)
+    assert [a.note_kind for a in acts]==['normal','off','cut','fade']
+    enc=[cc._encode_action(a) for a in acts[1:]]
+    assert any(0xFE in x for x in enc)
+    assert any(0xFC in x for x in enc)
+    assert any(0xFD in x for x in enc)
+
+
+def test_it_nna_continue_allocates_background_voice(tmp_path):
+    p=tmp_path/'nna.it'; make_it_profile(p,nna=1)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt)
+    st=cc.states[0]; e=_event()
+    p0,s0,_,_=cc._it_allocate_note_voice(e,st)
+    p1,s1,_,_=cc._it_allocate_note_voice(e,st)
+    assert p0==0 and p1==1 and not s0 and not s1
+    assert cc.it_voices[0]['state']=='background'
+    assert cc.it_voices[1]['state']=='foreground'
+    assert cc.it_voice_map[0]==1
+
+
+def test_it_nna_off_and_fade_emit_release_actions(tmp_path):
+    for nna,kind in ((2,'off'),(3,'fade')):
+        p=tmp_path/f'nna{nna}.it'; make_it_profile(p,nna=nna,fade=64)
+        m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt)
+        st=cc.states[0]; e=_event()
+        old,_,_,_=cc._it_allocate_note_voice(e,st)
+        new,synth,_,_=cc._it_allocate_note_voice(e,st)
+        assert new!=old and [x.note_kind for x in synth]==[kind]
+        assert synth[0].ch==old and cc.it_voices[old]['state']=='background'
+
+
+def test_it_dct_dca_cut_reuses_voice(tmp_path):
+    p=tmp_path/'dct.it'; make_it_profile(p,nna=1,dct=1,dca=0)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt)
+    st=cc.states[0]; e=_event()
+    old,_,_,_=cc._it_allocate_note_voice(e,st)
+    new,synth,_,_=cc._it_allocate_note_voice(e,st)
+    assert old==new==0
+    assert [(x.ch,x.note_kind) for x in synth]==[(0,'cut')]
+    assert cc.it_voices[0]['state']=='foreground'
+
+
+def test_it_nna_exact_24_voice_limit_fails(tmp_path):
+    p=tmp_path/'limit.it'; make_it_profile(p,nna=1)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt)
+    st=cc.states[0]; e=_event()
+    for _ in range(24): cc._it_allocate_note_voice(e,st)
+    try:
+        cc._it_allocate_note_voice(e,st)
+    except ValueError as exc:
+        assert 'more than 24 simultaneous OPL4 voices' in str(exc)
+    else:
+        raise AssertionError('25th exact NNA voice must fail rather than steal')
+
+
+
+def test_it_dct_note_uses_pattern_note_not_keymap_note(tmp_path):
+    p=tmp_path/'dct_pattern_note.it'; make_it_profile(p,nna=1,dct=1,dca=0)
+    b=bytearray(p.read_bytes())
+    # Map two distinct pattern notes to the same translated note/sample. DCT=Note
+    # must still treat them as different notes (OpenMPT kITDCTBehaviour).
+    for ni in (48,49):
+        b[INS_PTR+0x40+ni*2]=60
+        b[INS_PTR+0x41+ni*2]=1
+    p.write_bytes(b)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt)
+    st=cc.states[0]
+    e0=_event(0x40); e1=_event(0x41)
+    old,_,_,_=cc._it_allocate_note_voice(e0,st)
+    new,synth,_,_=cc._it_allocate_note_voice(e1,st)
+    assert old==0 and new==1 and synth==[]
+    assert cc.it_voices[0]['note']==48 and cc.it_voices[1]['note']==49
+
+
+def test_it_dct_sample_and_instrument_dca_release(tmp_path):
+    for dct,dca,kind in ((2,1,'off'),(3,2,'fade')):
+        p=tmp_path/f'dct{dct}_dca{dca}.it'; make_it_profile(p,nna=1,dct=dct,dca=dca,fade=64)
+        m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt)
+        st=cc.states[0]
+        old,_,_,_=cc._it_allocate_note_voice(_event(0x40),st)
+        new,synth,_,_=cc._it_allocate_note_voice(_event(0x41),st)
+        assert old==0 and new==1
+        assert [(x.ch,x.note_kind) for x in synth]==[(old,kind)]
+        assert cc.it_voices[old]['state']=='background'
+
+
+def test_it_volume_sustain_endpoint_does_not_autofade_while_held():
+    root=Path(__file__).resolve().parents[1]
+    asm=(root/'source'/'compact_engine_it.asm').read_text()
+    blk=asm.split('; Reaching the non-looping volume-envelope end starts instrument fade.',1)[1].split('it_tick_fade:',1)[0]
+    assert 'held sustain point' in blk.lower()
+    assert 'ld hl,ITKEYOFF' in blk and 'jr z,it_tick_fade' in blk
+
+def test_it_dynamic_stream_window_and_engine_layout(tmp_path):
+    p=tmp_path/'layout.it'; make_it_profile(p,fade=64,vol_env=(1,[(0,64),(8,0)],(0,0),(0,0)))
+    m,fmt=mf.parse_module(p)
+    assert t2k.stream_base_for(fmt)==0x7C00
+    template,engine,sym,pinfo=t2k.make_engine_template(m,1,fmt,[],stream_base=0x7C00)
+    assert len(engine)<=0x7C00-t2k.PAGE_LOAD
+    assert pinfo and sym['it_profile_data']>=0x6E00 and sym['it_profile_limit']==0x7C00
+    assert len(template)==t2k.PAGE_SIZE
+
