+        db 17,72,107,251,116,187,194,216,10,195,65,109,238,218,243,180
+        db 96,160,243,125,84,145,204,189,236,187,100,174,8,186,205,143
+        db 45,77,129,221,154,59,194,98,210,30,68,106,134,198,99,41
