+        ld (ROW_COUNT_TMP),a
+        or a
+        ret z
+        ld d,02h
+        ld e,011h              ; external memory write enable
+        call opl4_write_de
+alias_init_loop:
+        call read_stream_byte
+        jr c,alias_init_done
+        ld l,a
+        ld h,0
+        add hl,hl              ; *2
+        add hl,hl              ; *4
+        ld e,l
+        ld d,h
+        add hl,hl              ; *8
+        add hl,de              ; *12
+        push hl
+        ld d,03h
+        ld e,020h              ; custom header bank high address
+        call opl4_write_de
+        pop hl
+        push hl
+        ld d,04h
+        ld e,h
+        call opl4_write_de
+        pop hl
+        ld d,05h
+        ld e,l
+        call opl4_write_de
+        ld a,006h
+        out (07Eh),a
+        call opl4_wait
+        ld b,7
+alias_init_bytes:
+        call read_stream_byte
+        jr c,alias_init_done
+        out (07Fh),a
+        djnz alias_init_bytes
+        ld a,(ROW_COUNT_TMP)
+        dec a
+        ld (ROW_COUNT_TMP),a
+        jr nz,alias_init_loop
+alias_init_done:
+        ld d,02h
+        ld e,010h              ; normal wave-table mode / write disabled
+        jp opl4_write_de
