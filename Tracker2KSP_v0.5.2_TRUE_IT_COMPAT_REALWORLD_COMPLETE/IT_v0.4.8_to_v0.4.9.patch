+#!/usr/bin/env python3
+from pathlib import Path
+import struct, sys
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+import module_formats as mf
+import compact_stream as cs
+import tracker2ksp as t2k
+
+
+def _it_header(ordn=2,insn=0,smpn=1,patn=1,flags=0,cwtv=0x0214,cmwt=0x0214):
+    h=bytearray(0xC0)
+    h[:4]=b'IMPM'; h[4:30]=b'True IT v0.4.9 test'.ljust(26,b'\0')
+    struct.pack_into('<4H',h,0x20,ordn,insn,smpn,patn)
+    struct.pack_into('<4H',h,0x28,cwtv,cmwt,flags,0)
+    h[0x30:0x36]=bytes((128,48,6,125,128,0))
+    # Default pans and channel volumes. Channel 1 is centred / full volume.
+    h[0x40:0x80]=bytes([32]+[0x80]*63)
+    h[0x80:0xC0]=bytes([64]+[64]*63)
+    return h
+
+
+def make_it_samplemode(path:Path, *, compressed=False, cwtv=0x0214):
+    h=_it_header(cwtv=cwtv,cmwt=0x0214)
+    tables=bytearray(bytes((0,255)))
+    smp_ptr=0xD0; pat_ptr=0x130; data_ptr=0x180
+    tables+=struct.pack('<I',smp_ptr)+struct.pack('<I',pat_ptr)
+    blob=bytearray(max(data_ptr,0xC0+len(tables)))
+    blob[:0xC0]=h; blob[0xC0:0xC0+len(tables)]=tables
+    sh=bytearray(80); sh[:4]=b'IMPS'; sh[0x11]=64; sh[0x12]=1|(8 if compressed else 0); sh[0x13]=64
+    sh[0x14:0x1C]=b'Sample01'; sh[0x2E]=1; sh[0x2F]=0
+    struct.pack_into('<7I',sh,0x30,8,0,0,8363,0,0,data_ptr)
+    blob[smp_ptr:smp_ptr+80]=sh
+    # Four rows. Row 0 has all fields; row 1 uses all four previous-field bits.
+    pdata=bytes((0x81,0x0F,60,1,40,1,3,0, 0x81,0xF0,0, 0,0))
+    ph=struct.pack('<HHI',len(pdata),4,0)
+    blob[pat_ptr:pat_ptr+8+len(pdata)]=ph+pdata
+    if compressed:
+        # Eight 9-bit zero deltas -> nine zero bytes, one IT compressed block.
+        payload=struct.pack('<H',9)+bytes(9)
+    else:
+        payload=bytes((0,8,16,24,32,24,16,8))
+    if len(blob)<data_ptr: blob.extend(b'\0'*(data_ptr-len(blob)))
+    blob[data_ptr:data_ptr+len(payload)]=payload
+    path.write_bytes(blob)
+
+
+def make_it_instrumentmode(path:Path):
+    h=_it_header(insn=1,flags=0x04)
+    tables=bytearray(bytes((0,255)))
+    ins_ptr=0xD8; smp_ptr=0x320; pat_ptr=0x380; data_ptr=0x3D0
+    tables+=struct.pack('<III',ins_ptr,smp_ptr,pat_ptr)
+    blob=bytearray(data_ptr)
+    blob[:0xC0]=h; blob[0xC0:0xC0+len(tables)]=tables
+    ih=bytearray(554); ih[:4]=b'IMPI'; ih[0x11:0x14]=bytes((0,0,0)); ih[0x18]=128; ih[0x19]=0x80
+    ih[0x20:0x28]=b'Inst0001'
+    for n in range(120): ih[0x40+n*2]=n; ih[0x41+n*2]=1
+    blob[ins_ptr:ins_ptr+554]=ih
+    sh=bytearray(80); sh[:4]=b'IMPS'; sh[0x11]=64; sh[0x12]=1; sh[0x13]=48; sh[0x2E]=1; sh[0x2F]=0
+    struct.pack_into('<7I',sh,0x30,8,0,0,8363,0,0,data_ptr)
+    blob[smp_ptr:smp_ptr+80]=sh
+    pdata=bytes((0x81,0x03,48,1,0, 0,0,0))
+    blob[pat_ptr:pat_ptr+8+len(pdata)]=struct.pack('<HHI',len(pdata),4,0)+pdata
+    if len(blob)<data_ptr: blob.extend(b'\0'*(data_ptr-len(blob)))
+    blob[data_ptr:data_ptr+8]=bytes(range(8))
+    path.write_bytes(blob)
+
+
+def test_native_it_samplemode_parse_and_mask_reuse(tmp_path):
+    p=tmp_path/'sample.it'; make_it_samplemode(p)
+    m,fmt=mf.parse_module(p)
+    assert fmt=='IT' and m.source_format=='IT'
+    assert len(m.samples)==1 and m.samples[1].data[:4]==bytes((0,8,16,24))
+    e0=m.patterns[0][0][0]; e1=m.patterns[0][1][0]
+    assert (e0.note,e0.ins,e0.vol,e0.cmd,e0.param)==(0x50,1,40,1,3)
+    assert (e1.note,e1.ins,e1.vol,e1.cmd,e1.param)==(0x50,1,40,1,3)
+    cc=cs.CompactCompiler(m,fmt,max_seconds=1)
+    stream,rows,stats=cc.compile()
+    assert stream.startswith(b'CTR1') and rows and stats['semantic_rows']>=1
+
+
+def test_it214_and_it215_zero_compression(tmp_path):
+    for ver in (0x0214,0x0215):
+        p=tmp_path/f'c{ver:x}.it'; make_it_samplemode(p,compressed=True,cwtv=ver)
+        m,fmt=mf.parse_module(p)
+        assert fmt=='IT' and m.samples[1].data==bytes(8)
+
+
+def test_simple_instrument_keymap(tmp_path):
+    p=tmp_path/'instrument.it'; make_it_instrumentmode(p)
+    m,fmt=mf.parse_module(p)
+    assert fmt=='IT' and m.it_instrument_mode
+    cc=cs.CompactCompiler(m,fmt,max_seconds=1)
+    stream,rows,stats=cc.compile()
+    assert rows and cc.states[0].it_instrument_num==1
+    assert cc.states[0].instrument==1
+
+
+
+def test_native_it_effect_memory_rules(tmp_path):
+    p=tmp_path/'mem.it'; make_it_samplemode(p)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt); st=cs.ResolveState()
+    assert cc._resolve(st,cs.CMD_E,0x12)==0x12
+    assert cc._resolve(st,cs.CMD_F,0)==0x12          # native IT E/F shared memory
+    assert cc._resolve(st,cs.CMD_G,0)==0             # G is separate unless compatibility flag is set
+    assert cc._resolve(st,cs.CMD_G,0x34)==0x34
+    assert cc._resolve(st,cs.CMD_G,0)==0x34
+    m.it_compatible_gxx=True; st=cs.ResolveState()
+    assert cc._resolve(st,cs.CMD_E,0x45)==0x45
+    assert cc._resolve(st,cs.CMD_G,0)==0x45
+    assert cc._resolve(st,cs.CMD_G,0x67)==0x67
+    assert cc._resolve(st,cs.CMD_F,0)==0x67
+    st=cs.ResolveState()
+    assert cc._resolve(st,cs.CMD_I,0x30)==0x31
+    assert cc._resolve(st,cs.CMD_I,0x04)==0x34
+    assert cc._resolve(st,cs.CMD_I,0x00)==0x34
+    assert cc._resolve(st,cs.CMD_R,0x50)==0x50
+    assert cc._resolve(st,cs.CMD_R,0x06)==0x56
+    assert cc._resolve(st,cs.CMD_R,0x00)==0x56
+
+
+def test_native_it_s_subcommands_do_not_leak_st3_semantics(tmp_path):
+    p=tmp_path/'sfx.it'; make_it_samplemode(p)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt)
+    Event=mf.core.Event
+    # S1x / S2x are not implemented by native IT.
+    assert cc._event_action(Event(0,cmd=cs.CMD_S,param=0x11),cs.ResolveState()) is None
+    assert cc._event_action(Event(0,cmd=cs.CMD_S,param=0x2F),cs.ResolveState()) is None
+    # S3x/S4x values above 3 are ignored instead of masked with &3.
+    assert cc._event_action(Event(0,cmd=cs.CMD_S,param=0x37),cs.ResolveState()) is None
+    assert cc._event_action(Event(0,cmd=cs.CMD_S,param=0x4F),cs.ResolveState()) is None
+    a=cc._event_action(Event(0,cmd=cs.CMD_S,param=0x33),cs.ResolveState())
+    assert a.effects==[(cs.CMD_ST3_VIB_WAVE,3,None)]
+    # Native IT treats zero cut/delay as tick 1.
+    assert cc._event_action(Event(0,cmd=cs.CMD_S,param=0xC0),cs.ResolveState()).effects==[(cs.CMD_NOTE_CUT,1,None)]
+    assert cc._event_action(Event(0,note=0x50,ins=1,cmd=cs.CMD_S,param=0xD0),cs.ResolveState()).delay_tick==1
+
+
+def test_sample_mode_note_fade_is_ignored(tmp_path):
+    p=tmp_path/'fade.it'; make_it_samplemode(p)
+    b=bytearray(p.read_bytes())
+    # First packed event note byte at pattern data +2. 253 = Note Fade.
+    b[0x130+8+2]=253
+    p.write_bytes(b)
+    m,fmt=mf.parse_module(p)
+    e=m.patterns[0][0][0]
+    assert fmt=='IT' and e.note is None and e.it_note_special=='fade_ignored'
+
+
+def test_instrument_only_and_jxx_fail_fast(tmp_path):
+    p=tmp_path/'instrument_only.it'; make_it_instrumentmode(p)
+    b=bytearray(p.read_bytes())
+    # Replace the pattern with one instrument-only event followed by row ends.
+    pdata=bytes((0x81,0x02,1,0,0,0,0))
+    b[0x380:0x380+8+len(pdata)]=struct.pack('<HHI',len(pdata),4,0)+pdata
+    p.write_bytes(b)
+    try:
+        mf.parse_module(p)
+    except ValueError as exc:
+        assert 'instrument-only' in str(exc)
+    else:
+        raise AssertionError('instrument-only IT event must fail fast')
+
+    q=tmp_path/'jxx.it'; make_it_samplemode(q)
+    b=bytearray(q.read_bytes())
+    # First event effect command/parameter live at +5/+6 in packed data.
+    b[0x130+8+5]=10; b[0x130+8+6]=0x37
+    q.write_bytes(b)
+    try:
+        mf.parse_module(q)
+    except ValueError as exc:
+        assert 'Jxx arpeggio' in str(exc)
+    else:
+        raise AssertionError('native IT Jxx must fail fast in v0.4.9')
+
+
+def test_native_it_builds_with_dedicated_engine(tmp_path):
+    p=tmp_path/'build.it'; make_it_samplemode(p)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt,max_seconds=1)
+    stream,rows,stats=cc.compile(); mwk,waves,patches=t2k.build_mwk(m,cc.bank.order)
+    stream=cs.attach_alias_patches(stream,rows,patches)
+    out=tmp_path/'build.ksp'
+    rep=t2k.build_ksp(m,fmt,stream,rows,stats,mwk,waves,m.title,p.name,out,'none')
+    assert out.read_bytes()[:4]==b'KSP1'
+    assert rep['converter_version']=='0.4.9'
+    assert rep['engine']['binary_bytes']==len(t2k.IT_ENGINE_BIN)
+
+
+def test_native_it_runtime_quirks_are_separate():
+    root=Path(__file__).resolve().parents[1]
+    asm=(root/'source'/'compact_engine_it.asm').read_text()
+    it_s3m=(root/'source'/'compact_engine_it_s3m.asm').read_text()
+    # IT 2.04 Dxy testing order: Dx0, D0x, DxF, DFx. The dedicated runtime
+    # must retain the special DF0/D0F immediate compatibility step and DFF
+    # must fall into DxF before DFx.
+    vol=asm.split('effect_volume_slide:',1)[1].split('volume_add_a:',1)[0]
+    assert vol.index('it_vol_not_dx0:') < vol.index('it_vol_not_d0x:') < vol.index('it_vol_not_dxf:')
+    assert 'DF0 / D0F are regular slides *and* apply 15 immediately on tick 0' in vol
+    assert 'DFF therefore matches DxF first' in vol
+    # Native IT Hxy is evaluated on the row tick as well and uses twice-finer
+    # depth. Keep this difference out of the IT-authored-S3M engine.
+    vib=asm.split('effect_vibrato:',1)[1].split('effect_tremor:',1)[0]
+    assert 'EVERY tick, including tick 0' in vib
+    assert 'scale below uses /32 instead of /16' in vib
+    tremor=asm.split('effect_tremor:',1)[1].split('effect_tremolo:',1)[0]
+    assert 'x ticks on, y ticks off' in tremor
+    assert 'add 1' not in tremor.lower()
+    tremolo=asm.split('effect_tremolo:',1)[1].split('effect_sample_offset:',1)[0]
+    assert 'advances on every' in tremolo
+    assert 'waveform * depth / 128' in tremolo
+    retrig=asm.split('retrig_twothirds:',1)[1].split('retrig_half:',1)[0]
+    assert 'floor(2*volume/3)' in retrig
+    assert 'cp 3' in retrig and 'sub 3' in retrig
+    assert asm != it_s3m
+    assert t2k.IT_ENGINE_BIN != t2k.IT_S3M_ENGINE_BIN
