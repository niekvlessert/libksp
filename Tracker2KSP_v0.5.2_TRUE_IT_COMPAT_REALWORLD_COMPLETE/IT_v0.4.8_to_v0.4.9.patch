+
+parse_one_effect:
+        call read_stream_byte
+        ret c
+        ld b,a
+        and 080h
+        ld (SECOND_FX),a
+        ld a,b
+        and 07Fh
+        ld d,a                 ; command
+        call read_stream_byte
+        ret c
+        ld e,a                 ; parameter
+        ld a,d
+        cp CMD_A
+        jr nz,fx_not_speed
+        ld a,e
+        or a
+        ret z
+        ld (SPEED),a
+        or a
+        ret
+fx_not_speed:
+        cp CMD_T
+        jr nz,fx_not_tempo
+        ld a,e
+        cp 32
+        ret c
+        ld l,a
+        ld h,0
+        ld (TEMPO),hl
+        or a
+        ret
+fx_not_tempo:
+        cp CMD_X
+        jr nz,fx_not_pan
+        ld a,e
+        call set_pan_from_tracker
+        or a
+        ret
+fx_not_pan:
+        cp CMD_GLISS
+        jr nz,fx_not_gliss
+        ld a,e
+        ld hl,GLISS
+        call ptr8_cur
+        ld (hl),a
+        or a
+        ret
+fx_not_gliss:
+        cp CMD_ST3_VIBWAVE
+        jr nz,fx_not_vibwave
+        ld a,e
+        and 03h
+        ld hl,VIBTYPE
+        call ptr8_cur
+        ld (hl),a
+        or a
+        ret
+fx_not_vibwave:
+        cp CMD_ST3_TREMWAVE
+        jr nz,fx_not_tremwave
+        ld a,e
+        and 03h
+        ld hl,TREMTYPE
+        call ptr8_cur
+        ld (hl),a
+        or a
+        ret
+fx_not_tremwave:
+        cp CMD_ST3_PATDELAY
+        jr nz,fx_not_patdelay
+        ld a,e
+        ld (PAT_DELAY),a
+        or a
+        ret
+fx_not_patdelay:
+        cp CMD_ST3_TICKDELAY
+        jr nz,fx_not_tickdelay
+        ld a,e
+        ld (TICK_DELAY),a
+        or a
+        ret
+fx_not_tickdelay:
+        ; H updates nibble memory immediately; its resolved parameter already has both nibbles.
+        cp CMD_H
+        jr nz,fx_store
+        ld a,e
+        and 0F0h
+        rrca
+        rrca
+        rrca
+        rrca
+        push de
+        call store_vib_speed
+        pop de
+        ld a,e
+        and 00Fh
+        push de
+        call store_vib_depth
+        pop de
+fx_store:
+        ld a,(FX_SLOT)
+        cp 2
+        jr nc,fx_extra
+        or a
+        jr nz,fx_store_2
+        ld hl,CMD1
+        call ptr8_cur
+        ld (hl),d
+        ld hl,PAR1
+        call ptr8_cur
+        ld (hl),e
+        jr fx_store_inc
+fx_store_2:
+        ld hl,CMD2
+        call ptr8_cur
+        ld (hl),d
+        ld hl,PAR2
+        call ptr8_cur
+        ld (hl),e
+fx_store_inc:
+        ld a,(FX_SLOT)
+        inc a
+        ld (FX_SLOT),a
+fx_extra:
+        ld a,d
+        cp CMD_J
+        jr nz,fx_check_finetune
+        ; J carries two precomputed quarter-periods.
+        call read_stream_byte
+        ret c
+        ld e,a
+        call read_stream_byte
+        ret c
+        ld d,a
+        ld hl,ARP1
+        call ptr16_cur
+        ld (hl),e
+        inc hl
+        ld (hl),d
+        call read_stream_byte
+        ret c
+        ld e,a
+        call read_stream_byte
+        ret c
+        ld d,a
+        ld hl,ARP2
+        call ptr16_cur
+        ld (hl),e
+        inc hl
+        ld (hl),d
+        jr fx_done
+fx_check_finetune:
+        cp CMD_ST3_FINETUNE
+        jr nz,fx_done
+        call read_stream_byte
+        ret c
+        ld e,a
+        call read_stream_byte
+        ret c
+        ld d,a
+        ld hl,ARP1
+        call ptr16_cur
+        ld (hl),e
+        inc hl
+        ld (hl),d
+fx_done:
+        or a
+        ret
+
+finish_event_note:
+        ld a,(EV_NOTE_PRESENT)
+        or a
+        jr z,finish_no_note
+        ld a,(EV_NOTE_KIND)
+        cp 0FEh
+        jr z,do_note_off
+        cp 0FFh
+        jr z,queue_delayed_note
+        cp 080h
+        jr z,do_porta_target
+        cp 081h
+        jr z,queue_delayed_note
+        cp 082h
+        jr z,do_porta_swap
+        and 040h
+        jr nz,queue_delayed_note
+        jp do_normal_note
+finish_no_note:
+        ret
+
+do_porta_target:
+        ld hl,TARGET_Q
+        call ptr16_cur
+        ld de,(EV_PERIOD)
+        ld (hl),e
+        inc hl
+        ld (hl),d
+        ret
+
+; Impulse Tracker S3M compatibility: a tone-portamento note with a different
+; sample swaps to that sample and restarts it, while retaining the current
+; pitch and using the new note only as the portamento target.
+do_porta_swap:
+        call do_porta_target
+        ld a,(EV_TONE)
+        ld hl,WAVE
+        call ptr8_cur
+        ld (hl),a
+        call it_arm_retrig_on_note
+        call keyoff_current
+        ld a,(CUR_CH)
+        add a,008h
+        ld d,a
+        ld a,(EV_TONE)
+        add a,080h
+        ld e,a
+        call opl4_write_de
+        jp keyon_current
+
+; A note next to Qxy initializes IT's countdown and suppresses an immediate
+; retrigger on the same tick. Bit 7 is a one-tick skip marker.
+it_arm_retrig_on_note:
+        ld hl,CMD1
+        call ptr8_cur
+        ld a,(hl)
+        cp CMD_Q
+        jr z,it_arm_retrig_cmd1
+        ld hl,CMD2
+        call ptr8_cur
+        ld a,(hl)
+        cp CMD_Q
+        ret nz
+        ld hl,PAR2
+        jr it_arm_retrig_load
+it_arm_retrig_cmd1:
+        ld hl,PAR1
+it_arm_retrig_load:
+        call ptr8_cur
+        ld a,(hl)
+        and 0Fh
+        or 080h
+        ld b,a
+        ld hl,RETRIG_COUNT
+        call ptr8_cur
+        ld (hl),b
+        ret
+
+do_note_off:
+        jp keycut_current
+
+queue_delayed_note:
+        ld a,(EV_DELAY)
+        ld hl,DELAY_TICK
+        call ptr8_cur
+        ld (hl),a
+        ld a,(EV_NOTE_KIND)
+        ld hl,PEND_KIND
+        call ptr8_cur
+        ld (hl),a
+        ld a,(EV_TONE)
+        ld hl,PEND_TONE
+        call ptr8_cur
+        ld (hl),a
+        ld de,(EV_PERIOD)
+        ld hl,PEND_PERIOD
+        call ptr16_cur
+        ld (hl),e
+        inc hl
+        ld (hl),d
+        ld a,(EV_PLO)
+        ld hl,PEND_PLO
+        call ptr8_cur
+        ld (hl),a
+        ld a,(EV_PHI)
+        ld hl,PEND_PHI
+        call ptr8_cur
+        ld (hl),a
+        ld a,(EV_DVOL)
+        ld hl,PEND_VOL
+        call ptr8_cur
+        ld (hl),a
+        ret
+
+do_normal_note:
+        ; Save base/target quarter-period and tone.
+        call it_arm_retrig_on_note
+        ld de,(EV_PERIOD)
+        ld hl,PERIOD_Q
+        call ptr16_cur
+        ld (hl),e
+        inc hl
+        ld (hl),d
+        ld hl,TARGET_Q
+        call ptr16_cur
+        ld (hl),e
+        inc hl
+        ld (hl),d
+        ld a,(EV_TONE)
+        ld hl,WAVE
+        call ptr8_cur
+        ld (hl),a
+        xor a
+        ld hl,VIBPH
+        call ptr8_cur
+        ld (hl),a
+        ld hl,TREMPH
+        call ptr8_cur
+        ld (hl),a
+        ld hl,TREMOR_COUNT
+        call ptr8_cur
+        ld (hl),a
+        call keyoff_current
+        ; Exact host-computed base pitch and wave number 384+tone.
+        ld a,(CUR_CH)
+        add a,020h
+        ld d,a
+        ld a,(EV_PLO)
+        or 1
+        ld e,a
+        call opl4_write_de
+        ld a,(CUR_CH)
+        add a,008h
+        ld d,a
+        ld a,(EV_TONE)
+        add a,080h
+        ld e,a
+        call opl4_write_de
+        ld a,(CUR_CH)
+        add a,038h
+        ld d,a
+        ld a,(EV_PHI)
+        ld e,a
+        call opl4_write_de
+        jp keyon_current
+
+process_all_channels:
+        xor a
+        ld (CUR_CH),a
+process_ch_loop:
+        call process_delayed
+        ld hl,PERIOD_Q
+        call ptr16_cur
+        ld e,(hl)
+        inc hl
+        ld d,(hl)
+        ld (OUT_PERIOD),de
+        xor a
+        ld (PITCH_DIRTY),a
+        ; IT Qxy keeps its own countdown; there is no ST3 row-gap reset.
+        ld hl,CMD1
+        call ptr8_cur
+        ld d,(hl)
+        ld hl,PAR1
+        call ptr8_cur
+        ld e,(hl)
+        call apply_effect_de
+        ld hl,CMD2
+        call ptr8_cur
+        ld d,(hl)
+        ld hl,PAR2
+        call ptr8_cur
+        ld e,(hl)
+        call apply_effect_de
+        ld a,(PITCH_DIRTY)
+        or a
+        call nz,emit_pitch_approx
+        ld a,(CUR_CH)
+        inc a
+        ld (CUR_CH),a
+        cp 24
+        jr c,process_ch_loop
+        ret
+
+; Retained as an unreachable compatibility stub; IT does not use the
+; ST3 row-without-Q counter reset.
+it_unused_retrig_row_check:
+        ld a,(TICK_NOW)
+        or a
+        ret nz
+        ld hl,CMD1
+        call ptr8_cur
+        ld a,(hl)
+        cp CMD_Q
+        ret z
+        ld hl,CMD2
+        call ptr8_cur
+        ld a,(hl)
+        cp CMD_Q
+        ret z
+        xor a
+        ld hl,RETRIG_COUNT
+        call ptr8_cur
+        ld (hl),a
+        ret
+
+process_delayed:
+        ld hl,DELAY_TICK
+        call ptr8_cur
+        ld a,(hl)
+        cp 0FFh
+        ret z
+        ld b,a
+        ld a,(TICK_NOW)
+        cp b
+        ret nz
+        ld (hl),0FFh
+        ld hl,PEND_VOL
+        call ptr8_cur
+        ld a,(hl)
+        cp 0FFh
+        jr z,delay_no_vol
+        call set_volume_a
+delay_no_vol:
+        ld hl,PEND_KIND
+        call ptr8_cur
+        ld a,(hl)
+        cp 0FFh
+        jp z,keyoff_current
+        cp 081h
+        jr z,delay_porta
+        ; restore pending normal fields into event globals and trigger
+        ld hl,PEND_TONE
+        call ptr8_cur
+        ld a,(hl)
+        ld (EV_TONE),a
+        ld hl,PEND_PERIOD
+        call ptr16_cur
+        ld e,(hl)
+        inc hl
+        ld d,(hl)
+        ld (EV_PERIOD),de
+        ld hl,PEND_PLO
+        call ptr8_cur
+        ld a,(hl)
+        ld (EV_PLO),a
+        ld hl,PEND_PHI
+        call ptr8_cur
+        ld a,(hl)
+        ld (EV_PHI),a
+        jp do_normal_note
+delay_porta:
+        ld hl,PEND_PERIOD
+        call ptr16_cur
+        ld e,(hl)
+        inc hl
+        ld d,(hl)
+        ld hl,TARGET_Q
+        call ptr16_cur
+        ld (hl),e
+        inc hl
+        ld (hl),d
+        ret
+
+apply_effect_de:
+        ld a,d
+        or a
+        ret z
+        cp CMD_D
+        jp z,effect_volume_slide
+        cp CMD_E
+        jp z,effect_pitch_down
+        cp CMD_F
+        jp z,effect_pitch_up
+        cp CMD_G
+        jp z,effect_porta
+        cp CMD_H
+        jp z,effect_vibrato
+        cp CMD_I
+        jp z,effect_tremor
+        cp CMD_J
+        jp z,effect_arpeggio
+        cp CMD_Q
+        jp z,effect_retrig
+        cp CMD_R
+        jp z,effect_tremolo
+        cp CMD_ST3_FINETUNE
+        jp z,effect_finetune
+        cp CMD_CUT
+        jp z,effect_note_cut
+        ret
+
+effect_volume_slide:
+        ; Native Impulse Tracker Dxy semantics (IT 2.04):
+        ; test in this order: Dx0, D0x, DxF, DFx.
+        ; DF0 / D0F are regular slides *and* apply 15 immediately on tick 0.
+        ; DFF therefore matches DxF first and is an immediate +15 fine slide.
+        ld a,e
+        and 0F0h
+        ld b,a                    ; B = high nibble << 4
+        ld a,e
+        and 00Fh
+        ld c,a                    ; C = low nibble
+
+        ; Dx0: regular slide up. x=F also acts immediately for S3M compat.
+        ld a,c
+        or a
+        jr nz,it_vol_not_dx0
+        ld a,b
+        or a
+        ret z
+        rrca
+        rrca
+        rrca
+        rrca
+        and 0Fh
+        ld b,a                    ; B = slide amount
+        ld a,(TICK_NOW)
+        or a
+        jr nz,it_vol_up_b
+        ld a,b
+        cp 0Fh
+        ret nz                    ; ordinary Dx0 starts after row tick
+it_vol_up_b:
+        ld a,b
+        jp volume_add_a
+
+it_vol_not_dx0:
+        ; D0x: regular slide down. x=F also acts immediately for S3M compat.
+        ld a,b
+        or a
+        jr nz,it_vol_not_d0x
+        ld a,(TICK_NOW)
+        or a
+        jr nz,it_vol_down_c
+        ld a,c
+        cp 0Fh
+        ret nz                    ; ordinary D0x starts after row tick
+it_vol_down_c:
+        ld a,c
+        jp volume_sub_a
+
+it_vol_not_d0x:
+        ; DxF: fine slide up on row tick only. This precedes DFx, so DFF=+15.
+        ld a,c
+        cp 0Fh
+        jr nz,it_vol_not_dxf
+        ld a,(TICK_NOW)
+        or a
+        ret nz
+        ld a,b
+        rrca
+        rrca
+        rrca
+        rrca
+        and 0Fh
+        jp volume_add_a
+
+it_vol_not_dxf:
+        ; DFx: fine slide down on row tick only.
+        ld a,b
+        cp 0F0h
+        ret nz                    ; other mixed-nibble forms do nothing in IT
+        ld a,(TICK_NOW)
+        or a
+        ret nz
+        ld a,c
+        jp volume_sub_a
+
+volume_add_a:
+        ld b,a
+        ld hl,VOLUME
+        call ptr8_cur
+        ld a,(hl)
+        add a,b
+        cp 65
+        jr c,volume_store
+        ld a,64
+volume_store:
+        ld (hl),a
+        jp emit_volume_current
+volume_sub_a:
+        ld b,a
+        ld hl,VOLUME
+        call ptr8_cur
+        ld a,(hl)
+        cp b
+        jr nc,volume_sub_ok
+        xor a
+        jr volume_store
+volume_sub_ok:
+        sub b
+        jr volume_store
+
+effect_pitch_down:
+        ld a,e
+        call slide_delta_q
+        ret c
+        ex de,hl                 ; DE=delta q
+        ld hl,PERIOD_Q
+        call ptr16_cur
+        ld a,(hl)
+        ld c,a
+        inc hl
+        ld a,(hl)
+        ld b,a
+        ld h,b
+        ld l,c
+        add hl,de
+        jr nc,pitch_down_store
+        ld hl,0FFFFh
+pitch_down_store:
+        call store_period_hl
+        ret
+
+effect_pitch_up:
+        ld a,e
+        call slide_delta_q
+        ret c
+        ex de,hl                 ; DE=delta
+        ld hl,PERIOD_Q
+        call ptr16_cur
+        ld c,(hl)
+        inc hl
+        ld b,(hl)
+        ld h,b
+        ld l,c
+        or a
+        sbc hl,de
+        jr nc,pitch_up_nonzero
+        ld hl,1
+pitch_up_nonzero:
+        ld a,h
+        or l
+        jr nz,pitch_up_store
+        inc hl
+pitch_up_store:
+        call store_period_hl
+        ret
+
+; Input A=slide parameter, output HL=quarter-period delta, CF=0 when active.
+; CF=1 means no slide on this tick.
+slide_delta_q:
+        ld b,a
+        and 0F0h
+        cp 0F0h
+        jr z,slide_fine
+        cp 0E0h
+        jr z,slide_extra_fine
+        ld a,(TICK_NOW)
+        or a
+        jr z,slide_inactive
+        ld a,b
+        ld l,a
+        ld h,0
+        add hl,hl
+        add hl,hl
+        or a
+        ret
+slide_fine:
+        ld a,(TICK_NOW)
+        or a
+        jr nz,slide_inactive
+        ld a,b
+        and 0Fh
+        ld l,a
+        ld h,0
+        add hl,hl
+        add hl,hl
+        or a
+        ret
+slide_extra_fine:
+        ld a,(TICK_NOW)
+        or a
+        jr nz,slide_inactive
+        ld a,b
+        and 0Fh
+        ld l,a
+        ld h,0
+        or a
+        ret
+slide_inactive:
+        scf
+        ret
+
+store_period_hl:
+        ld (OUT_PERIOD),hl
+        push hl
+        ex de,hl
+        ld hl,PERIOD_Q
+        call ptr16_cur
+        ld (hl),e
+        inc hl
+        ld (hl),d
+        pop hl
+        ld a,1
+        ld (PITCH_DIRTY),a
+        ret
+
+effect_porta:
+        ld a,(TICK_NOW)
+        or a
+        ret z
+        ld a,e
+        or a
+        ret z
+        ld l,a
+        ld h,0
+        add hl,hl
+        add hl,hl
+        push hl                   ; step
+        ld hl,PERIOD_Q
+        call ptr16_cur
+        ld e,(hl)
+        inc hl
+        ld d,(hl)                 ; DE=current
+        ld hl,TARGET_Q
+        call ptr16_cur
+        ld c,(hl)
+        inc hl
+        ld b,(hl)                 ; BC=target
+        ; compare current DE with target BC
+        ld h,d
+        ld l,e
+        or a
+        sbc hl,bc
+        pop hl                    ; HL=step
+        jr z,porta_done
+        jr c,porta_current_lower
+        ; current > target: subtract step, clamp at target
+        ex de,hl                  ; DE=step, HL=current
+        or a
+        sbc hl,de
+        push hl
+        or a
+        sbc hl,bc
+        pop hl
+        jr nc,porta_store
+        ld h,b
+        ld l,c
+        jr porta_store
+porta_current_lower:
+        ; current < target: add step, clamp at target
+        ex de,hl                  ; DE=step, HL=current
+        add hl,de
+        push hl
+        or a
+        sbc hl,bc
+        pop hl
+        jr c,porta_store
+        jr z,porta_store
+        ld h,b
+        ld l,c
+porta_store:
+        call store_period_hl
+porta_done:
+        ret
+
+effect_vibrato:
+        ; Native IT Hxy (Old Effects is rejected by the host): vibrato is
+        ; evaluated and phase-updated on EVERY tick, including tick 0. IT H
+        ; depth is twice as fine as ST3's H depth, so the final waveform*depth
+        ; scale below uses /32 instead of /16.
+        ld hl,VIBPH
+        call ptr8_cur
+        ld a,(hl)
+        and 3Fh
+        call get_vib_wave_current
+        ld b,a
+        ld hl,VIBPH
+        call ptr8_cur
+        ld a,(hl)
+        ld c,a
+        ld hl,VIBSPD
+        call ptr8_cur
+        ld a,(hl)
+        add a,c
+        and 3Fh
+        ld hl,VIBPH
+        call ptr8_cur
+        ld (hl),a
+        ld a,b
+        or a
+        ret z
+        jp p,vib_positive
+        neg
+        ld b,1
+        jr vib_abs_ready
+vib_positive:
+        ld b,0
+vib_abs_ready:
+        ld e,a
+        ld d,0
+        push bc
+        ld hl,VIBDEP
+        call ptr8_cur
+        ld a,(hl)
+        ld c,a
+        ld hl,0
+        ld b,0
+vib_mul_loop:
+        ld a,c
+        or a
+        jr z,vib_mul_done
+        add hl,de
+        dec c
+        jr vib_mul_loop
+vib_mul_done:
+        srl h
+        rr l
+        srl h
+        rr l
+        srl h
+        rr l
+        srl h
+        rr l
+        srl h
+        rr l
+        ld e,l
+        ld d,0
+        pop bc
+        ld hl,(OUT_PERIOD)
+        ld a,b
+        or a
+        jr nz,vib_sub
+        add hl,de
+        jr vib_store_out
+vib_sub:
+        or a
+        sbc hl,de
+        jr nc,vib_store_out
+        ld hl,1
+vib_store_out:
+        ld (OUT_PERIOD),hl
+        ld a,e
+        or d
+        ret z
+        ld a,1
+        ld (PITCH_DIRTY),a
+        ret
+
+effect_tremor:
+        ; Native IT Ixy with Old Effects disabled: x ticks on, y ticks off.
+        ; The host resolves the independent zero-nibble memories, so E always
+        ; carries the current nonzero/default on/off lengths.
+        ld a,e
+        and 0F0h
+        rrca
+        rrca
+        rrca
+        rrca
+        and 0Fh
+        ld b,a                 ; on length x
+        ld a,e
+        and 0Fh
+        ld c,a                 ; off length y
+        ld hl,TREMOR_COUNT
+        call ptr8_cur
+        ld a,b
+        add a,c
+        ld d,a                 ; cycle length x+y
+        or a
+        ret z
+        ld a,(hl)
+        cp d
+        jr c,it_tremor_count_ok
+        xor a
+        ld (hl),a
+it_tremor_count_ok:
+        ld e,a                 ; current count
+        inc a
+        cp d
+        jr c,it_tremor_store
+        xor a
+it_tremor_store:
+        ld (hl),a
+        ld a,e
+        cp b
+        jr nc,it_tremor_off
+        ld hl,VOLUME
+        call ptr8_cur
+        ld a,(hl)
+        jp emit_volume_a_temp
+it_tremor_off:
+        xor a
+        jp emit_volume_a_temp
+
+effect_tremolo:
+        ; Native IT Rxy (Old Effects disabled). The host resolves independent
+        ; speed/depth nibble memory. Like IT vibrato, tremolo advances on every
+        ; tick including the row tick, and its depth is twice finer than old FX.
+        ld a,e
+        and 0F0h
+        rrca
+        rrca
+        rrca
+        rrca
+        and 0Fh
+        ld hl,TREMSPD
+        call ptr8_cur
+        ld (hl),a
+        ld a,e
+        and 0Fh
+        ld hl,TREMDEP
+        call ptr8_cur
+        ld (hl),a
+        ld hl,TREMPH
+        call ptr8_cur
+        ld a,(hl)
+        and 3Fh
+        call get_trem_wave_current
+        ld b,a                 ; signed waveform delta
+        ld hl,TREMPH
+        call ptr8_cur
+        ld a,(hl)
+        ld c,a
+        ld hl,TREMSPD
+        call ptr8_cur
+        ld a,(hl)
+        add a,c
+        and 3Fh
+        ld hl,TREMPH
+        call ptr8_cur
+        ld (hl),a
+        ld a,b
+        or a
+        jr z,trem_emit_base
+        jp p,trem_positive
+        neg
+        ld c,1
+        jr trem_abs_ready
+trem_positive:
+        ld c,0
+trem_abs_ready:
+        ld e,a
+        ld d,0
+        push bc
+        ld hl,TREMDEP
+        call ptr8_cur
+        ld a,(hl)
+        ld b,a
+        ld hl,0
+trem_mul:
+        ld a,b
+        or a
+        jr z,trem_mul_done
+        add hl,de
+        dec b
+        jr trem_mul
+trem_mul_done:
+        ; Native IT new-effects depth is twice finer: waveform * depth / 128.
+        srl h
+        rr l
+        srl h
+        rr l
+        srl h
+        rr l
+        srl h
+        rr l
+        srl h
+        rr l
+        srl h
+        rr l
+        srl h
+        rr l
+        ld e,l
+        pop bc
+        ld hl,VOLUME
+        call ptr8_cur
+        ld a,(hl)
+        ld b,a
+        ld a,c
+        or a
+        ld a,b
+        jr nz,trem_sub
+        add a,e
+        cp 65
+        jr c,trem_emit
+        ld a,64
+        jr trem_emit
+trem_sub:
+        sub e
+        jr nc,trem_emit
+        xor a
+trem_emit:
+        jp emit_volume_a_temp
+trem_emit_base:
+        ld hl,VOLUME
+        call ptr8_cur
+        ld a,(hl)
+        jp emit_volume_a_temp
+
+effect_finetune:
+        ld a,(TICK_NOW)
+        or a
+        ret nz
+        ld hl,ARP1
+        call ptr16_cur
+        ld e,(hl)
+        inc hl
+        ld d,(hl)
+        ld a,d
+        or e
+        ret z
+        ld hl,PERIOD_Q
+        call ptr16_cur
+        ld (hl),e
+        inc hl
+        ld (hl),d
+        ld hl,TARGET_Q
+        call ptr16_cur
+        ld (hl),e
+        inc hl
+        ld (hl),d
+        ld (OUT_PERIOD),de
+        ld a,1
+        ld (PITCH_DIRTY),a
+        ret
+
+effect_arpeggio:
+        ld a,(TICK_NOW)
+arp_mod3:
+        cp 3
+        jr c,arp_mod_done
+        sub 3
+        jr arp_mod3
+arp_mod_done:
+        or a
+        ret z
+        cp 1
+        jr nz,arp_use_2
+        ld hl,ARP1
+        jr arp_load
+arp_use_2:
+        ld hl,ARP2
+arp_load:
+        call ptr16_cur
+        ld e,(hl)
+        inc hl
+        ld d,(hl)
+        ld a,d
+        or e
+        ret z
+        ld (OUT_PERIOD),de
+        ld a,1
+        ld (PITCH_DIRTY),a
+        ret
+
+effect_retrig:
+        ; IT Qxy countdown semantics. A note+Qxy arms bit 7 in
+        ; it_arm_retrig_on_note, so the note is not retriggered immediately.
+        ld a,e
+        and 0Fh
+        ret z
+        ld b,a
+        ld hl,RETRIG_COUNT
+        call ptr8_cur
+        ld a,(hl)
+        bit 7,a
+        jr z,it_retrig_count
+        and 0Fh
+        ld (hl),a
+        ret
+it_retrig_count:
+        and 0Fh
+        jr z,it_retrig_fire
+        dec a
+        ld (hl),a
+        ret nz
+it_retrig_fire:
+        ld (hl),b
+        ; IT short-sample retrigger: do not resurrect an already stopped voice.
+        ld hl,KEYSTATE
+        call ptr8_cur
+        ld a,(hl)
+        or a
+        ret z
+        ld a,e
+        and 0F0h
+        rrca
+        rrca
+        rrca
+        rrca
+        and 0Fh
+        call retrig_adjust_volume
+        call keyoff_current
+        jp keyon_current
+
+retrig_adjust_volume:
+        cp 0
+        ret z
+        cp 8
+        ret z
+        cp 1
+        jr z,retrig_sub1
+        cp 2
+        jr z,retrig_sub2
+        cp 3
+        jr z,retrig_sub4
+        cp 4
+        jr z,retrig_sub8
+        cp 5
+        jr z,retrig_sub16
+        cp 7
+        jr z,retrig_half
+        cp 9
+        jr z,retrig_add1
+        cp 10
+        jr z,retrig_add2
+        cp 11
+        jr z,retrig_add4
+        cp 12
+        jr z,retrig_add8
+        cp 13
+        jr z,retrig_add16
+        cp 15
+        jr z,retrig_double
+        ; x=6 (~2/3) and x=14 (~1.5) use compact approximations.
+        cp 6
+        jr z,retrig_twothirds
+        ; x=14
+        ld hl,VOLUME
+        call ptr8_cur
+        ld a,(hl)
+        ld b,a
+        srl a
+        add a,b
+        cp 65
+        jr c,retrig_store_a
+        ld a,64
+        jr retrig_store_a
+retrig_twothirds:
+        ; IT Qx6 uses the classic floor(2*volume/3) table exactly.
+        ld hl,VOLUME
+        call ptr8_cur
+        ld a,(hl)
+        ld b,0
+it_retrig_2_3_loop:
+        cp 3
+        jr c,it_retrig_2_3_rem
+        sub 3
+        inc b
+        inc b
+        jr it_retrig_2_3_loop
+it_retrig_2_3_rem:
+        cp 2
+        jr c,it_retrig_2_3_done
+        inc b
+it_retrig_2_3_done:
+        ld a,b
+        jr retrig_store_a
+retrig_half:
+        ld hl,VOLUME
+        call ptr8_cur
+        ld a,(hl)
+        srl a
+        jr retrig_store_a
+retrig_double:
+        ld hl,VOLUME
+        call ptr8_cur
+        ld a,(hl)
+        add a,a
+        cp 65
+        jr c,retrig_store_a
+        ld a,64
+        jr retrig_store_a
+retrig_sub1: ld a,1
+        jr retrig_sub
+retrig_sub2: ld a,2
+        jr retrig_sub
+retrig_sub4: ld a,4
+        jr retrig_sub
+retrig_sub8: ld a,8
+        jr retrig_sub
+retrig_sub16: ld a,16
+retrig_sub:
+        call volume_sub_a
+        ret
+retrig_add1: ld a,1
+        jr retrig_add
+retrig_add2: ld a,2
+        jr retrig_add
+retrig_add4: ld a,4
+        jr retrig_add
+retrig_add8: ld a,8
+        jr retrig_add
+retrig_add16: ld a,16
+retrig_add:
+        call volume_add_a
+        ret
+retrig_store_a:
+        ld hl,VOLUME
+        call ptr8_cur
+        ld (hl),a
+        jp emit_volume_current
+
+effect_note_cut:
+        ld a,(TICK_NOW)
+        cp e
+        ret nz
+        xor a
+        call set_volume_a
+        jp keycut_current
+
+set_volume_a:
+        cp 65
+        jr c,set_volume_ok
+        ld a,64
+set_volume_ok:
+        ld hl,VOLUME
+        call ptr8_cur
+        ld (hl),a
+        jp emit_volume_current
+
+emit_volume_current:
+        ld hl,VOLUME
+        call ptr8_cur
+        ld e,(hl)
+        ld d,0
+        ld hl,VOL_LUT
+        add hl,de
+        ld e,(hl)
+        ld a,(CUR_CH)
+        add a,050h
+        ld d,a
+        jp opl4_write_de
+
+emit_volume_a_temp:
+        cp 65
+        jr c,emit_temp_ok
+        ld a,64
+emit_temp_ok:
+        ld e,a
+        ld d,0
+        ld hl,VOL_LUT
+        add hl,de
+        ld e,(hl)
+        ld a,(CUR_CH)
+        add a,050h
+        ld d,a
+        jp opl4_write_de
+
+set_pan_from_tracker:
+        ; A=0..255 tracker pan. OPL4: 9..15 left, 1..7 right, 0 centre.
+        cp 128
+        jr nc,pan_right
+        rrca
+        rrca
+        rrca
+        rrca
+        and 07h
+        ld b,a
+        ld a,7
+        sub b
+        jr z,pan_center
+        add a,8
+        jr pan_store
+pan_right:
+        sub 128
+        rrca
+        rrca
+        rrca
+        rrca
+        and 07h
+        jr z,pan_center
+        jr pan_store
+pan_center:
+        xor a
+pan_store:
+        ld hl,PAN
+        call ptr8_cur
+        ld (hl),a
+        ; Update pan register immediately while preserving key-on state.
+        ld e,a
+        ld hl,KEYSTATE
+        call ptr8_cur
+        ld a,(hl)
+        or a
+        jr z,pan_no_key
+        ld a,e
+        or 080h
+        ld e,a
+pan_no_key:
+        ld a,(CUR_CH)
+        add a,068h
+        ld d,a
+        jp opl4_write_de
+
+store_vib_speed:
+        ld hl,VIBSPD
+        call ptr8_cur
+        ld (hl),a
+        ret
+store_vib_depth:
+        ld hl,VIBDEP
+        call ptr8_cur
+        ld (hl),a
+        ret
+
+get_vib_wave_current:
+        ld c,a
+        ld hl,VIBTYPE
+        call ptr8_cur
+        ld b,(hl)
+        jr get_mod_wave
+
+get_trem_wave_current:
+        ld c,a
+        ld hl,TREMTYPE
+        call ptr8_cur
+        ld b,(hl)
+get_mod_wave:
+        ld a,b
+        and 03h
+        or a
+        jr z,mod_wave_sine
+        cp 1
+        jr z,mod_wave_ramp
+        cp 2
+        jr z,mod_wave_square
+        ld e,c
+        ld d,0
+        ld hl,RANDOM_TABLE
+        add hl,de
+        ld a,(hl)
+        ret
+mod_wave_sine:
+        ld e,c
+        ld d,0
+        ld hl,SINE_TABLE
+        add hl,de
+        ld a,(hl)
+        ret
+mod_wave_ramp:
+        ld a,c
+        add a,a
+        add a,a
+        ld b,a
+        ld a,c
+        cp 32
+        jr nc,mod_ramp_hi
+        xor a
+        sub b
+        ret
+mod_ramp_hi:
+        ld a,0FFh
+        sub b
+        ret
+mod_wave_square:
+        ld a,c
+        cp 32
+        ld a,127
+        ret c
+        ld a,129               ; -127 signed
+        ret
+
+keycut_current:
+        ; S3M note-off is a cut, not a long envelope release.
+        ; YMF278B DAMP reaches silence in about 11 ms and is cleared by keyon.
+        ld hl,PAN
+        call ptr8_cur
+        ld a,(hl)
+        or 040h
+        ld e,a
+        ld a,(CUR_CH)
+        add a,068h
+        ld d,a
+        call opl4_write_de
+        xor a
+        ld hl,KEYSTATE
+        call ptr8_cur
+        ld (hl),a
+        ret
+
+keyoff_current:
+        ld hl,PAN
+        call ptr8_cur
+        ld e,(hl)
+        ld a,(CUR_CH)
+        add a,068h
+        ld d,a
+        call opl4_write_de
+        xor a
+        ld hl,KEYSTATE
+        call ptr8_cur
+        ld (hl),a
+        ret
+keyon_current:
+        ld hl,PAN
+        call ptr8_cur
+        ld a,(hl)
+        or 080h
+        ld e,a
+        ld a,(CUR_CH)
+        add a,068h
+        ld d,a
+        call opl4_write_de
+        ld a,1
+        ld hl,KEYSTATE
+        call ptr8_cur
+        ld (hl),a
+        ret
+
+emit_pitch_approx:
+        ld hl,(OUT_PERIOD)
+        ld a,0FDh                ; signed octave -3
+pitch_norm_low:
+        ld de,2574
+        push hl
+        or a
+        sbc hl,de
+        pop hl
+        jr nc,pitch_norm_high
+        add hl,hl
+        inc a
+        cp 8
+        jr nz,pitch_norm_low
+pitch_norm_high:
+        ld de,5148
+        push hl
+        or a
+        sbc hl,de
+        pop hl
+        jr c,pitch_norm_ready
+        ; rounded right shift
+        inc hl
+        srl h
+        rr l
+        dec a
+        cp 0F8h                  ; -8
+        jr nz,pitch_norm_high
+pitch_norm_ready:
+        ld (EV_PHI),a            ; temporary octave
+        ld de,2560
+        or a
+        sbc hl,de
+        add hl,hl
+        ld de,PITCH_LUT
+        add hl,de
+        ld e,(hl)                ; reg20 fnum bits
+        inc hl
+        ld b,(hl)                ; fnum high 3 bits
+        ld a,e
+        or 1
+        ld e,a
+        ld a,(CUR_CH)
+        add a,020h
+        ld d,a
+        push bc
+        call opl4_write_de
+        pop bc
+        ld a,(EV_PHI)
+        and 0Fh
+        add a,a
+        add a,a
+        add a,a
+        add a,a
+        or b
+        ld e,a
+        ld a,(CUR_CH)
+        add a,038h
+        ld d,a
+        jp opl4_write_de
+
+stream_end:
+        ld a,1
+        ld (ENDED),a
+        call silence
+        ret
+
+ptr8_cur:
+        push af
+        push de
+        ld a,(CUR_CH)
+        ld e,a
+        ld d,0
+        add hl,de
+        pop de
+        pop af
+        ret
+ptr16_cur:
+        push af
+        push de
+        ld a,(CUR_CH)
+        add a,a
+        ld e,a
+        ld d,0
+        add hl,de
+        pop de
+        pop af
+        ret
+
+read_stream_byte:
+        push de
+        ld hl,(PTR)
+        ld de,(PAGE_END)
+        or a
+        sbc hl,de
+        jr c,read_have
+        call load_next_page
+        jr c,read_fail
+read_have:
+        ld hl,(PTR)
+        ld a,(hl)
+        inc hl
+        ld (PTR),hl
+        or a
+        pop de
+        ret
+read_fail:
+        pop de
+        scf
+        ret
+
+load_next_page:
+        ld hl,(PAGE_INDEX)
+        inc hl
+        ld (PAGE_INDEX),hl
+        push hl
+        ld de,(PAGE_TOTAL_CFG)
+        or a
+        sbc hl,de
+        pop hl
+        jr nc,no_more_pages
+        ; Enter the host gateway with carry clear.  KSP1PLAY explicitly returns
+        ; carry clear on success; TinyKSP's host-intercepted gateway preserves CPU
+        ; flags, so relying on the comparison carry above would falsely signal an
+        ; error after every successful page install.
+        or a
+        ; The KSP dynamic gateway rematerializes the complete 16 KiB page.
+        ; Preserve realtime tracker state in the top 512 bytes of MoonSound RAM
+        ; across that replacement. Sample packing reserves this area.
+        push hl
+        call save_persistent_state
+        pop hl
+        call DYNAMIC_GATEWAY
+        jr c,load_page_gateway_failed
+        call restore_persistent_state
+        ld hl,STREAM_DATA
+        ld (PTR),hl
+        call set_page_end
+        or a
+        ret
+load_page_gateway_failed:
+        call restore_persistent_state
+        scf
+        ret
+no_more_pages:
+        scf
+        ret
+
+set_page_end:
+        ld hl,(STREAM_PAGE)
+        ld de,STREAM_DATA
+        add hl,de
+        ld (PAGE_END),hl
+        ret
+
+; ---------------------------------------------------------------------------
+; Dynamic-page persistent state
+;
+; Dynamic materialization replaces 4000h..7FFFh, including our RAM state.
+; Store only state that must survive between rows in reserved MoonSound RAM
+; 2FFE00h..2FFFFFh. 301 bytes are used; the converter never places MWK sample
+; payload in this final 512-byte window. CMD/PAR/delay/ARP scratch is row-local
+; and deliberately not persisted because page changes only occur between rows.
+; ---------------------------------------------------------------------------
+
+state_mem_address:
+        ld d,03h
+        ld e,02Fh              ; 2FFE00h high six address bits
+        call opl4_write_de
+        ld d,04h
+        ld e,0FEh
+        call opl4_write_de
+        ld d,05h
+        ld e,000h
+        call opl4_write_de
+        ld a,006h
+        out (07Eh),a
+        jp opl4_wait
+
+save_persistent_state:
+        ld d,02h
+        ld e,011h              ; memory access + write enable
+        call opl4_write_de
+        call state_mem_address
+        ld hl,PAGE_INDEX
+        ld bc,9                ; PAGE_INDEX..ENDED (includes ROW_TICK)
+        call state_write_block
+        ld hl,FAST_VOL
+        ld bc,31               ; FAST_VOL..HOLD_ROW
+        call state_write_block
+        ld hl,PERIOD_Q
+        ld bc,CMD1-PERIOD_Q    ; periods/target/volume/wave/key state
+        call state_write_block
+        ld hl,VIBSPD
+        ld bc,ARP1-VIBSPD      ; vibrato speed/depth/phase
+        call state_write_block
+        ld hl,PAN
+        ld bc,24
+        call state_write_block
+        ld hl,TREMOR_COUNT
+        ld bc,168
+        call state_write_block
+        ld d,02h
+        ld e,010h              ; leave MoonSound RAM write disabled
+        jp opl4_write_de
+
+state_write_block:
+        ld a,b
+        or c
+        ret z
+state_write_loop:
+        ld a,(hl)
+        out (07Fh),a
+        inc hl
+        dec bc
+        ld a,b
+        or c
+        jr nz,state_write_loop
+        ret
+
+restore_persistent_state:
+        ld d,02h
+        ld e,011h              ; enable external-memory access for sequential reads
+        call opl4_write_de
+        call state_mem_address
+        ld hl,PAGE_INDEX
+        ld bc,9
+        call state_read_block
+        ld hl,FAST_VOL
+        ld bc,31               ; FAST_VOL..HOLD_ROW
+        call state_read_block
+        ld hl,PERIOD_Q
+        ld bc,CMD1-PERIOD_Q
+        call state_read_block
+        ld hl,VIBSPD
+        ld bc,ARP1-VIBSPD
+        call state_read_block
+        ld hl,PAN
+        ld bc,24
+        call state_read_block
+        ld hl,TREMOR_COUNT
+        ld bc,168
+        call state_read_block
+        ld d,02h
+        ld e,010h              ; return MoonSound to normal wave-table mode
+        jp opl4_write_de
+
+state_read_block:
+        ld a,b
+        or c
+        ret z
+state_read_loop:
+        in a,(07Fh)
+        ld (hl),a
+        inc hl
+        dec bc
+        ld a,b
+        or c
+        jr nz,state_read_loop
+        ret
+
+opl4_write_de:
+        ld a,d
+        out (07Eh),a
+        call opl4_wait
+        ld a,e
+        out (07Fh),a
+        jp opl4_wait
+opl4_wait:
+        push bc
+        ld b,16
+opl4_wait_loop:
+        in a,(07Eh)
+        djnz opl4_wait_loop
+        pop bc
+        ret
+
+silence:
+        ld d,050h
+        ld e,0FFh
+        ld b,24
+silence_level:
+        call opl4_write_de
+        inc d
+        djnz silence_level
+        ld d,068h
+        ld e,040h
+        ld b,24
+silence_key:
+        call opl4_write_de
+        inc d
+        djnz silence_key
+        ret
+
+SINE_TABLE:
+        db 0,12,25,37,49,60,71,81,90,98,106,112,117,122,125,126
+        db 127,126,125,122,117,112,106,98,90,81,71,60,49,37,25,12
+        db 0,244,231,219,207,196,185,175,166,158,150,144,139,134,131,130
+        db 129,130,131,134,139,144,150,158,166,175,185,196,207,219,231,244
+RANDOM_TABLE:
+        db 98,129,213,88,102,41,191,162,125,20,185,170,186,224,240,160
+        db 17,72,107,251,116,187,194,216,10,195,65,109,238,218,243,180
+        db 96,160,243,125,84,145,204,189,236,187,100,174,8,186,205,143
+        db 45,77,129,221,154,59,194,98,210,30,68,106,134,198,99,41
+
+
+; Preserve the v0.3.8 table addresses exactly. The generic engine historically
+; has a small PITCH_LUT/state overlap, so moving these tables changes playback.
+        defs 4,0
+
+; 65-byte volume -> OPL4 TL register table. The converter patches this per song/global volume.
+VOL_LUT:
+        defs 65,0
+
+FT2_VIB_TAB:
+        db 0,24,49,74,97,120,141,161,180,197,212,224,235,244,250,253
+        db 255,253,250,244,235,224,212,197,180,161,141,120,97,74,49,24
