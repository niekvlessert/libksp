diff -ruN '--exclude=*.bin' '--exclude=*.map' '--exclude=*.lst' '--exclude=SHA256SUMS.txt' '--exclude=*.patch' a/tests/test_it_v051.py b/tests/test_it_v051.py
--- a/tests/test_it_v051.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_it_v051.py	2026-08-22 22:55:14.980651940 +0000
@@ -0,0 +1,139 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import struct, sys, math
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+import module_formats as mf
+import compact_stream as cs
+import tracker2ksp as t2k
+from test_it_v049 import make_it_samplemode
+
+
+def _patch_fx(path:Path, cmd:int, param:int):
+    b=bytearray(path.read_bytes())
+    # v0.4.9 synthetic sample-mode fixture: first packed cell command/param.
+    b[0x130+8+5]=cmd; b[0x130+8+6]=param
+    b[0x130+8+9]=0x70  # row 1 reuses note/instrument/volume, but not effect
+    path.write_bytes(b)
+
+
+def test_it_v051_parser_accepts_extended_effects_and_z_remains_fail_fast(tmp_path):
+    for cmd,param in ((cs.CMD_J,0x37),(cs.CMD_M,40),(cs.CMD_N,0x20),(cs.CMD_P,0x03),
+                      (cs.CMD_T,0x11),(cs.CMD_U,0x34),(cs.CMD_V,96),(cs.CMD_W,0x10),(cs.CMD_Y,0x23)):
+        p=tmp_path/f'e{cmd}.it'; make_it_samplemode(p); _patch_fx(p,cmd,param)
+        m,fmt=mf.parse_module(p)
+        assert fmt=='IT' and m.patterns[0][0][0].cmd==cmd
+    p=tmp_path/'z.it'; make_it_samplemode(p); _patch_fx(p,cs.CMD_Z,0x80)
+    try:
+        mf.parse_module(p)
+    except ValueError as exc:
+        assert 'MIDI macro' in str(exc) or 'filter macro' in str(exc)
+    else:
+        raise AssertionError('native IT Zxx must remain fail-fast until MIDI/filter macros are implemented')
+
+
+def test_it_v051_effect_memory_is_it_local_and_h_u_share(tmp_path):
+    p=tmp_path/'mem.it'; make_it_samplemode(p)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt); st=cs.ResolveState()
+    assert cc._resolve(st,cs.CMD_N,0x24)==0x24
+    assert cc._resolve(st,cs.CMD_N,0)==0x24
+    assert cc._resolve(st,cs.CMD_P,0x3F)==0x3F
+    assert cc._resolve(st,cs.CMD_P,0)==0x3F
+    assert cc._resolve(st,cs.CMD_W,0x41)==0x41
+    assert cc._resolve(st,cs.CMD_W,0)==0x41
+    assert cc._resolve(st,cs.CMD_T,0x11)==0x11
+    assert cc._resolve(st,cs.CMD_T,0)==0x11
+    assert cc._resolve(st,cs.CMD_H,0x34)==0x34
+    assert cc._resolve(st,cs.CMD_U,0x05)==0x35
+    assert cc._resolve(st,cs.CMD_H,0x60)==0x65
+    assert cc._resolve(st,cs.CMD_Y,0x23)==0x23
+    assert cc._resolve(st,cs.CMD_Y,0x04)==0x24
+    assert cc._resolve(st,cs.CMD_Y,0)==0x24
+
+
+def test_it_v051_initial_channel_and_global_volume_are_dynamic(tmp_path):
+    p=tmp_path/'vol.it'; make_it_samplemode(p)
+    b=bytearray(p.read_bytes())
+    b[0x30]=80       # IT global volume 0..128
+    b[0x80]=40       # tracker channel 1 volume 0..64
+    p.write_bytes(b)
+    m,fmt=mf.parse_module(p)
+    assert fmt=='IT' and m.it_global_volume==80 and m.it_channel_volume[0]==40
+    cc=cs.CompactCompiler(m,fmt,max_seconds=1)
+    stream,rows,stats=cc.compile()
+    assert cc.states[0].it_channel_volume==40
+    # IT LUT is neutral; global volume is a runtime multiplier, not baked twice.
+    template,_,sym,_=t2k.make_engine_template(m,1,'IT',[],t2k.IT_STREAM_BASE)
+    vo=sym['vol_lut']-t2k.PAGE_LOAD
+    neutral=bytes(mf.core.Compiler._level_reg(v,64) for v in range(65))
+    assert template[vo:vo+65]==neutral
+    assert rows and rows[0][0]>=2  # synthetic initial V action + source cell
+
+
+def test_it_v051_n_p_w_t_host_state_tracks_tick_semantics(tmp_path):
+    # N20: +2 channel-volume on ticks 1..5 => +10 from 40.
+    p=tmp_path/'n.it'; make_it_samplemode(p); b=bytearray(p.read_bytes()); b[0x80]=40; p.write_bytes(b); _patch_fx(p,cs.CMD_N,0x20)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt,max_seconds=10); cc.compile()
+    assert cc.states[0].it_channel_volume==50
+
+    # P20: left 8 tracker-pan units on ticks 1..5 => 128 -> 88.
+    p=tmp_path/'p.it'; make_it_samplemode(p); _patch_fx(p,cs.CMD_P,0x20)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt,max_seconds=10); cc.compile()
+    assert cc.states[0].it_pan_tracker==88
+
+    # W10: +1 global volume on ticks 1..5, starting from 128 -> clamp 128.
+    p=tmp_path/'w.it'; make_it_samplemode(p); b=bytearray(p.read_bytes()); b[0x30]=100; p.write_bytes(b); _patch_fx(p,cs.CMD_W,0x10)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt,max_seconds=10); cc.compile()
+    assert cc.it_global_volume==105
+
+    # T11: +1 BPM on ticks 1..5; effect is row-local so later rows keep 130.
+    p=tmp_path/'t.it'; make_it_samplemode(p); _patch_fx(p,cs.CMD_T,0x11)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt,max_seconds=10); cc.compile()
+    assert cc.tempo==130
+
+
+def test_it_v051_fine_slide_tick_zero_priority(tmp_path):
+    # N2F is fine +2 once on row tick 0 (no pattern delay in fixture).
+    p=tmp_path/'nf.it'; make_it_samplemode(p); b=bytearray(p.read_bytes()); b[0x80]=40; p.write_bytes(b); _patch_fx(p,cs.CMD_N,0x2F)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt,max_seconds=10); cc.compile()
+    assert cc.states[0].it_channel_volume==42
+    # P2F is fine-left 8 once.
+    p=tmp_path/'pf.it'; make_it_samplemode(p); _patch_fx(p,cs.CMD_P,0x2F)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt,max_seconds=10); cc.compile()
