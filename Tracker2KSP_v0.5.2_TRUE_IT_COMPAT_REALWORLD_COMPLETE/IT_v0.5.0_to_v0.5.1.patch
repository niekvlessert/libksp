+def test_it_v051_engine_is_physically_separate_and_contains_effect_runtime():
+    root=Path(__file__).resolve().parents[1]
+    asm=(root/'source'/'compact_engine_it.asm').read_text()
+    mp=(root/'source'/'compact_engine_it.map').read_text().lower()
+    for label in ('effect_channel_volume_slide:','effect_pan_slide:','effect_tempo_slide:',
+                  'effect_fine_vibrato:','effect_global_volume_slide:','effect_panbrello:',
+                  'process_it_global_tick_effects:'):
+        assert label in asm
+    # Txx/Wxx are global effects: they must run in the pre-pass, never again
+    # from the ordinary per-physical-voice dispatcher (which would make the
+    # result depend on channel order and/or apply the slide twice).
+    dispatch=asm.split('apply_effect_de:',1)[1].split('effect_volume_slide:',1)[0]
+    assert 'cp CMD_T' not in dispatch and 'cp CMD_W' not in dispatch
+    global_dispatch=asm.split('it_apply_global_de:',1)[1].split('clear_panbrello_offset:',1)[0]
+    assert 'cp CMD_T' in global_dispatch and 'cp CMD_W' in global_dispatch
+    fine_vib=asm.split('effect_fine_vibrato:',1)[1].split('effect_panbrello:',1)[0]
+    assert 'jp p,it_u_pos\n        neg\n        ld b,1' in fine_vib
+    assert 'neg\n        neg' not in fine_vib
+    for sym in ('itchvol =','itglobalvol =','panbrph =','panbroff ='):
+        assert sym in mp
+    assert len(t2k.IT_ENGINE_BIN)==12288
+    assert t2k.IT_ENGINE_BIN != t2k.IT_S3M_ENGINE_BIN
+    assert len(t2k.S3M_ENGINE_BIN)==9054 and len(t2k.MOD_ENGINE_BIN)==10674 and len(t2k.XM_ENGINE_BIN)==6472
+    # All state that must survive a semantic-page swap still fits in the
+    # converter-reserved final 1 KiB of MoonSound RAM.
+    syms={}
+    for line in mp.splitlines():
+        if ' = 0x' in line:
+            name,val=line.split(' = 0x',1)
+            try: syms[name.strip()]=int(val.strip(),16)
+            except ValueError: pass
+    persisted=(9 + 31 + (syms['cmd1']-syms['period_q']) +
+               (syms['arp1']-syms['vibspd']) + 24 + 168 +
+               (syms['ext_state_end']-syms['itprof']))
+    assert persisted==905 and persisted<=1024
