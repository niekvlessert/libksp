+#!/usr/bin/env python3
+from pathlib import Path
+from tempfile import TemporaryDirectory
+from types import SimpleNamespace
+import sys
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+import _s3m2opl4_backend as core
+import compact_stream as cs
+import module_formats
+
+
+def make_header(cwtv=0x1300, speed=6, tempo=125, master=0x80, flags=0, pattern=False):
+    size = 0x180 if pattern else 0x61
+    b = bytearray(size)
+    b[:8] = b'TESTS3M\0'
+    b[0x1C] = 0x1A; b[0x1D] = 0x10
+    b[0x20:0x22] = (1).to_bytes(2,'little')
+    b[0x22:0x24] = (0).to_bytes(2,'little')
+    b[0x24:0x26] = (1 if pattern else 0).to_bytes(2,'little')
+    b[0x26:0x28] = flags.to_bytes(2,'little')
+    b[0x28:0x2A] = cwtv.to_bytes(2,'little')
+    b[0x2A:0x2C] = (1).to_bytes(2,'little')
+    b[0x2C:0x30] = b'SCRM'
+    b[0x30]=64; b[0x31]=speed; b[0x32]=tempo; b[0x33]=master
+    b[0x40:0x60] = bytes([0] + [255]*31)
+    b[0x60]=0
+    if pattern:
+        # parapointer immediately follows the one order byte
+        b[0x61:0x63] = (0x10).to_bytes(2,'little')
+        p=0x100
+        b[p:p+2]=(1).to_bytes(2,'little')  # deliberately wrong packed length
+        p+=2
+        # Three tokens for the same channel. Correct parsing merges fields.
+        b[p:p+3]=bytes([0x20, 0x40, 1]); p+=3  # note + instrument, row still open
+        b[p:p+2]=bytes([0x40, 160]); p+=2          # volume-column pan = 32
+        b[p:p+3]=bytes([0x80, 8, 0x47]); p+=3      # H47
+        b[p]=0; p+=1
+        # Complete all 64 rows so ignoring the bogus packed length is safe.
+        b[p:p+63]=bytes(63)
+    return bytes(b)
+
+
+def test_effect_memory():
+    dummy = SimpleNamespace(s3m_cwtv=0x1300)
+    cc = object.__new__(cs.CompactCompiler); cc.fmt='S3M'; cc.m=dummy
+    st=cs.ResolveState()
+    assert cc._resolve(st, cs.CMD_H, 0x81)==0x81
+    assert st.global_mem==0x81
+    assert cc._resolve(st, cs.CMD_D, 0)==0x81
+    # NONE + nonzero must not overwrite shared ST3 memory.
+    assert cc._resolve(st, 0, 0x77)==0x77
+    assert st.global_mem==0x81
+    # Any real non-zero command, even Axx, updates the shared byte.
+    assert cc._resolve(st, cs.CMD_A, 0x06)==0x06
+    assert cc._resolve(st, cs.CMD_D, 0)==0x06
+
+    # Keep the legacy backend in sync too.
+    c=core.Channel()
+    legacy=object.__new__(core.Compiler)
+    assert legacy._resolve_param(c,'H',0x81)==0x81
+    assert legacy._resolve_param(c,'D',0)==0x81
+    legacy._resolve_param(c,'',0x77)
+    assert c.global_mem==0x81
+    legacy._resolve_param(c,'A',0x06)
+    assert legacy._resolve_param(c,'D',0)==0x06
+
+
+def test_profile_defaults_and_parser_merge():
+    with TemporaryDirectory() as td:
+        td=Path(td)
+        p=td/'strict.s3m'; p.write_bytes(make_header(cwtv=0x1300,speed=0,tempo=0,master=0))
+        m,fmt=module_formats.parse_s3m_profile(p)
+        assert fmt=='S3M' and m.s3m_profile.startswith('ST3-')
+        assert (m.speed,m.tempo)==(6,125)
+        assert not m.s3m_is_stereo
+
+        p=td/'modern.s3m'; p.write_bytes(make_header(cwtv=0x5132,speed=0,tempo=0,master=0x80))
+        m,fmt=module_formats.parse_s3m_profile(p)
+        assert fmt=='MODERN-S3M'
+        assert (m.speed,m.tempo)==(6,32)
+
+        p=td/'merge.s3m'; p.write_bytes(make_header(cwtv=0x5132,pattern=True))
+        m=core.parse_s3m(p)
+        e=m.patterns[0][0][0]
+        assert len(m.patterns[0][0])==1
+        assert (e.note,e.ins,e.cmd,e.param)==(0x40,1,8,0x47)
+        assert getattr(e,'volume_pan')==32
+
+
+def test_stereo_16bit_decode():
+    # Signed 16-bit split stereo planes: averages are +0x2000 and -0x2000,
+    # which become signed 8-bit 0x20 and 0xE0.
+    left=(0x4000).to_bytes(2,'little',signed=True)+(-0x4000).to_bytes(2,'little',signed=True)
+    right=(0).to_bytes(2,'little',signed=True)+(0).to_bytes(2,'little',signed=True)
+    out=core._decode_s3m_pcm(left+right,2,0x06,1)
+    assert out==bytes([0x20,0xE0])
+
+
+def test_mono_pan_and_runtime_guards():
+    m=SimpleNamespace(channel_panning_nibbles=[None]*32,s3m_is_stereo=False,channel_settings=[0]*32)
+    cc=object.__new__(cs.CompactCompiler); cc.m=m; cc.fmt='S3M'
+    assert cc._pan_nibble(0)==0
+
+    asm=(Path(__file__).resolve().parents[1]/'source'/'compact_engine_s3m.asm').read_text()
+    combined=asm.split('s3m_combined_volume_slide:',1)[1].split('\n\n',1)[0]
+    assert 'ld a,(TICK_NOW)' in combined and 'ret z' in combined
+    retrig=asm.split('effect_retrig:',1)[1].split('retrig_adjust_volume:',1)[0]
+    assert 'ST3 Qx0 behaves as interval 1' in retrig and 'inc a' in retrig
+    assert 'effect_tremor:' in asm and 'effect_tremolo:' in asm
+
+
+def main():
+    tests=[v for k,v in sorted(globals().items()) if k.startswith('test_') and callable(v)]
+    for fn in tests:
+        fn(); print('PASS',fn.__name__)
+    print(f'PASS {len(tests)} S3M v0.4.5 regression groups')
+
+if __name__=='__main__': main()
