+def _decode_xm_adpcm(raw: bytes, sample_len: int) -> bytes:
+    """Decode ModPlug's XM 4-bit ADPCM (16-byte signed delta table + nibbles)."""
+    if len(raw) < 16:
+        return b''
+    table=[_s8(x) for x in raw[:16]]
