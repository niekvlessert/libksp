+def test_amiga_vs_linear(tmp):
+    cc=compact_stream.CompactCompiler(module_one_sample(tmp/'p'),'XM',max_seconds=1)
+    pl=cc._xm_linear_period(1,48)
+    pa=cc._xm_amiga_period(1,48)
+    assert pl==4608 and 1600<pa<1800,(pl,pa)
+    # E5x nibble 8 is zero finetune; 9 is +16.
+    assert cc._xm_linear_period(1,48,0)==4608
+    assert cc._xm_linear_period(1,48,16)<4608
