+def test_flow_and_offset(tmp):
+    m=module_one_sample(tmp/'flow')
+    # EEx extends one row by (x+1) * speed ticks and is carried as runtime cmd 56.
+    e=ev(cmd=compact_stream.CMD_XM_PATDELAY,param=2,extra_effects=[],xm_instrument_present=False,xm_note_present=False)
+    m.patterns=[[[e]]]; m.orders=[0]; m.xm_restart=0
+    cc=compact_stream.CompactCompiler(m,'XM',max_seconds=2)
+    stream,rows,rep=cc.compile()
+    assert rep['semantic_rows']==1 and abs(rep['duration_seconds']-0.36)<1e-9,rep
+    assert bytes([compact_stream.CMD_XM_PATDELAY,2]) in rows[0]
+    # F00 terminates the flattened song at this row.
+    m=module_one_sample(tmp/'stop'); m.xm_restart=0
+    stop=ev(cmd=compact_stream.CMD_XM_STOP,param=0,extra_effects=[],xm_instrument_present=False,xm_note_present=False)
+    m.patterns=[[[stop]], [[]]]; m.orders=[0]
+    cc=compact_stream.CompactCompiler(m,'XM',max_seconds=2)
+    _,_,rep=cc.compile(); assert rep['semantic_rows']==1 and rep['end_reason']=='FT2 F00 stop'
+    # FT2 9xx memory is only written next to a real note.
+    m=module_one_sample(tmp/'ofs'); cc=compact_stream.CompactCompiler(m,'XM',max_seconds=1); st=compact_stream.ResolveState(xm_instrument_num=1)
