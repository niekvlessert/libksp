+def test_ft2_delay_and_note_limit(tmp):
+    cc=compact_stream.CompactCompiler(module_one_sample(tmp/'delay'),'XM',max_seconds=1)
+    # FT2 NoteLimit.xm behaviour: a sample transpose that pushes the note out
+    # of NOTE_MIN+11..NOTE_MIN+130 suppresses the note trigger completely.
+    cc.m.samples[1].xm_relative_note=95
+    st=compact_stream.ResolveState()
+    e=ev(note=0x7B,cmd=None,param=None,xm_instrument_present=True,xm_instrument_number=1,
+         xm_note_present=True,xm_volume_column=0,extra_effects=[])  # B-7 / XM note 96
+    a=cc._event_action(e,st)
+    assert a is not None and a.note_kind is None and not st.period_seen
+    cc.m.samples[1].xm_relative_note=0
+
+    # VolColDelay.xm semantics are carried explicitly to the Z80 runtime.
+    st=compact_stream.ResolveState(instrument=1,note_index=48,period_seen=True,xm_instrument_num=1)
+    e=ev(note=0x40,cmd=compact_stream.CMD_S,param=0xD3,
+         xm_instrument_present=True,xm_instrument_number=1,xm_note_present=True,
+         xm_volume_column=0x64,extra_effects=[(compact_stream.CMD_XM_VC_VOLDN,4,False)])
+    a=cc._event_action(e,st)
+    cmds=[x[0] for x in a.effects]
+    assert compact_stream.CMD_XM_ROWDELAY in cmds and compact_stream.CMD_XM_ROWINS in cmds and compact_stream.CMD_XM_VC_VOLDN in cmds,cmds
+
+    # PanOff.xm: delayed Note Off ignores volume-column Cx panning.
+    st=compact_stream.ResolveState(instrument=1,note_index=48,period_seen=True,xm_instrument_num=1)
+    e=ev(note=254,cmd=compact_stream.CMD_S,param=0xD2,
+         xm_instrument_present=False,xm_note_present=False,xm_volume_column=0xC8,
+         extra_effects=[(compact_stream.CMD_X,32,False)])
+    a=cc._event_action(e,st)
+    assert all(x[0] != compact_stream.CMD_X for x in a.effects)
+
+    # RetrigTick0.xm: retain literal row note/instrument/volume markers so the
+    # runtime can reproduce FT2's Rxy first-tick counter bugs.
+    st=compact_stream.ResolveState(instrument=1,note_index=48,period_seen=True,xm_instrument_num=1)
+    e=ev(note=0x40,cmd=compact_stream.CMD_XM_RETRIG,param=0x60,vol=32,
+         xm_instrument_present=True,xm_instrument_number=1,xm_note_present=True,
+         xm_volume_column=0x30,extra_effects=[])
+    a=cc._event_action(e,st); cmds=[x[0] for x in a.effects]
+    assert compact_stream.CMD_XM_ROWNOTE in cmds and compact_stream.CMD_XM_ROWINS in cmds and compact_stream.CMD_XM_ROWVOL in cmds,cmds
+
+    asm=(ROOT/'source'/'compact_engine_xm.asm').read_text()
+    assert 'jp xm_reset_current_profile_clocks' in asm
+    assert 'CMD3            equ 06400h' in asm
+    rblock=asm.split('effect_xm_retrig:',1)[1].split('effect_xm_tremolo:',1)[0]
+    assert 'xm_reset_current_profile_clocks' not in rblock
+
