+def make_old_sample_xm(path:Path, version=0x0103):
+    b=bytearray()
+    b += b'Extended Module: ' + b'OldLayout'.ljust(20,b'\0') + b'\x1a'
+    b += b'FastTracker v2.00   '.ljust(20,b' ')
+    b += struct.pack('<H',version) + struct.pack('<I',276)
+    b += struct.pack('<8H',1,0,1,1,1,1,6,125)
+    b += bytes([0])+bytes(255)
+    ih=bytearray(263); struct.pack_into('<I',ih,0,263); ih[4:11]=b'OldInst'; struct.pack_into('<H',ih,27,1); struct.pack_into('<I',ih,29,40)
+    b += ih
+    sh=bytearray(40); struct.pack_into('<III',sh,0,4,0,0); sh[12]=48; sh[15]=128; sh[18:21]=b'old'; b += sh
+    cell=bytes([49,1,0,0,0])
+    b += struct.pack('<IBHH',9,0,1,len(cell)) + cell
+    b += bytes([1,0,0,0])
+    path.write_bytes(b)
+
+
+def test_old_sample_layout(tmp):
+    p=tmp/'old103.xm'; make_old_sample_xm(p)
+    m=module_formats.parse_xm(p)
+    assert m.xm_version==0x0103 and len(m.samples)==1 and m.xm_instrument_sample_ids[1]==(1,)
+    assert m.samples[1].data[:4]==bytes([1,1,1,1])
+    cc=compact_stream.CompactCompiler(m,'XM',max_seconds=1)
+    a=cc._event_action(m.patterns[0][0][0],compact_stream.ResolveState())
+    assert a and a.note_kind=='normal'
+
+def make_multisample_xm(path:Path):
+    b=bytearray()
+    b += b'Extended Module: ' + b'Keymap'.ljust(20,b'\0') + b'\x1a'
+    b += b'FastTracker v2.00   '.ljust(20,b' ')
+    b += struct.pack('<H',0x0104) + struct.pack('<I',276)
+    b += struct.pack('<8H',2,0,1,2,1,1,6,125)
+    b += bytes([0,1])+bytes(254)
+    assert len(b)==336
+    # Pattern 0: C-4, instrument 1. Pattern 1: C#4, no instrument.
+    for cell in (bytes([49,1,0,0,0]), bytes([50,0,0,0,0])):
+        b += struct.pack('<IBHH',9,0,1,len(cell)) + cell
+    ih=bytearray(263)
+    struct.pack_into('<I',ih,0,263); ih[4:10]=b'Inst 1'; struct.pack_into('<H',ih,27,2); struct.pack_into('<I',ih,29,40)
+    # sample map: C-4 sample 0, C#4 sample 1
+    ih[33:129]=bytes(96); ih[33+49]=1
+    b += ih
+    for name,vol,pan in ((b'S0',20,40),(b'S1',50,220)):
+        sh=bytearray(40); struct.pack_into('<III',sh,0,4,0,0); sh[12]=vol; sh[15]=pan; sh[18:18+len(name)]=name; b+=sh
+    b += bytes([1,0,0,0]) + bytes([2,0,0,0])
+    path.write_bytes(b)
+
+
+def test_dynamic_keymap(tmp):
+    p=tmp/'keymap.xm'; make_multisample_xm(p); m=module_formats.parse_xm(p)
+    assert m.xm_instrument_sample_ids[1] == (1,2)
+    cc=compact_stream.CompactCompiler(m,'XM',max_seconds=2)
+    st=compact_stream.ResolveState()
+    e0=m.patterns[0][0][0]; a0=cc._event_action(e0,st)
+    assert a0 and st.xm_instrument_num==1 and st.instrument==1
+    e1=m.patterns[1][0][0]; a1=cc._event_action(e1,st)
+    assert a1 and a1.note_kind=='normal' and st.instrument==2, (a1,st)
+
