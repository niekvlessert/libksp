+def test_it_v052_porta_reapplies_pan_gain_and_compatible_gxx_profile(tmp_path):
+    p=tmp_path/'porta-defaults.it'; make_it_instrumentmode(p)
+    _patch_it_defaults(p,pps=8,ppc=48,igv=64,span=0x80|40)
+    m,fmt=mf.parse_module(p); assert fmt=='IT'
+    m.it_compatible_gxx=True
+    cc=cs.CompactCompiler(m,fmt); st=cc.states[0]
+    st.instrument=1; st.period_seen=True; st.note_index=48; st.it_instrument_num=1
+    e=m.patterns[0][0][0]; e.cmd=cs.CMD_G; e.param=4
+    a=cc._event_action(e,st)
+    assert a.note_kind=='porta'
+    assert any(ec==cs.CMD_X for ec,_,_ in a.effects)
+    assert (cs.CMD_IT_GAIN,32,None) in a.effects
+    assert any(ec==cs.CMD_IT_PROFILE for ec,_,_ in a.effects)
+
