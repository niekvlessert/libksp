+        ; HL=x, BC=Q16 delta -> HL=round(x*delta/65536)
+        ld (LIN_X),hl
+        ld a,c
+        ld (LIN_D),a
+        ld a,b
+        ld (LIN_D+1),a
+        ; p0 = xl*dl
+        ld a,(LIN_D)
+        ld c,a
+        ld a,(LIN_X)
+        call it_mul8x8
+        ld (LIN_P0),hl
+        ; p1 = xl*dh
+        ld a,(LIN_D+1)
+        ld c,a
+        ld a,(LIN_X)
+        call it_mul8x8
+        ld (LIN_P1),hl
+        ; p2 = xh*dl
+        ld a,(LIN_D)
+        ld c,a
+        ld a,(LIN_X+1)
+        call it_mul8x8
+        ld (LIN_P2),hl
+        ; p3 = xh*dh
+        ld a,(LIN_D+1)
+        ld c,a
+        ld a,(LIN_X+1)
+        call it_mul8x8
+        ld (LIN_P3),hl
+        ; t = p1+p2+(p0>>8)+128; result = p3+(t>>8)
+        ld hl,(LIN_P1)
+        ld de,(LIN_P2)
+        ld b,0
+        add hl,de
+        jr nc,it_lin_t1
+        inc b
+it_lin_t1:
+        ld a,(LIN_P0+1)
+        add a,080h
