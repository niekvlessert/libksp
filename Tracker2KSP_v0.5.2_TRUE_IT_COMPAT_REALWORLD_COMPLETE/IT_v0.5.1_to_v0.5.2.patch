+def test_it_v052_porta_sample_change_fails_fast(tmp_path):
+    import copy
+    p=tmp_path/'porta-swap.it'; make_it_samplemode(p)
+    m,fmt=mf.parse_module(p); assert fmt=='IT'
+    m.samples[2]=copy.deepcopy(m.samples[1])
+    cc=cs.CompactCompiler(m,fmt); st=cc.states[0]
+    st.instrument=1; st.period_seen=True; st.note_index=48
+    src=m.patterns[0][0][0]
+    e=mf.core.Event(ch=0,note=src.note,ins=2,cmd=cs.CMD_G,param=4)
+    try: cc._event_action(e,st)
+    except ValueError as exc: assert 'tone-portamento with sample change' in str(exc) and 'C5' in str(exc)
+    else: raise AssertionError('IT G/L sample changes must not silently use the old sample C5 semantics')
+
