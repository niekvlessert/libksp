+def test_it_v052_runtime_stream_window_and_direct_effect_carry_safety():
+    asm=(ROOT/'source'/'compact_engine_it.asm').read_text()
+    mp=(ROOT/'source'/'compact_engine_it.map').read_text().lower(); syms={}
+    for line in mp.splitlines():
+        if ' = 0x' in line:
+            n,v=line.split(' = 0x',1)
+            try: syms[n.strip()]=int(v.strip(),16)
+            except ValueError: pass
+    # The native-IT stream was moved to 7C00 in v0.5.0. STREAM_DATA must move
+    # with it; otherwise INIT reads speed/tempo from resident code/state.
+    assert 'STREAM_DATA     equ STREAM_PAGE+2' in asm
+    assert syms['stream_page']==0x7C00 and syms['stream_data']==0x7C02
+    # parse_effects uses carry exclusively as a true stream-read failure flag.
+    # Valid Mxx/Vxx comparisons therefore clear carry before returning, while
+    # T0x/T1x must fall through to the realtime-effect store instead of RET C.
+    mblk=asm.split('fx_not_tempo:',1)[1].split('fx_not_m:',1)[0]
+    vblk=asm.split('fx_not_m:',1)[1].split('fx_not_v:',1)[0]
+    tblk=asm.split('fx_not_speed:',1)[1].split('fx_not_tempo:',1)[0]
+    assert 'ld (hl),a\n        or a\n        ret' in mblk
+    assert 'ld (ITGLOBALVOL),a\n        or a\n        ret' in vblk
+    assert 'cp 32\n        jr nc,fx_tempo_absolute' in tblk
+    assert 'jp fx_store' in tblk and 'ret c' not in tblk
+
+
+def test_it_v052_dynamic_page_count_uses_ksp_16bit_range():
+    assert t2k.MAX_SUPPORTED_PAGES==0xFFFF
+    # Regression for real high-row-rate IT modules (e.g. speed 1 / tempo 250):
+    # more than the old artificial 48-page ceiling is valid KSP 1.05.
+    stream=bytearray(cs.HEADER_SIZE); stream[:4]=cs.STREAM_MAGIC
+    stream[4]=cs.STREAM_VERSION
+    rows=[bytes((i&0x7F,))*900 for i in range(64)]
+    pages=t2k.split_semantic_pages(bytes(stream),rows,'IT')
+    assert len(pages)>48
+    assert len(pages)<=0xFFFF
