+def test_it_v052_runtime_layout_gain_and_profile_space():
+    mp=(ROOT/'source'/'compact_engine_it.map').read_text().lower(); syms={}
+    for line in mp.splitlines():
+        if ' = 0x' in line:
+            n,v=line.split(' = 0x',1)
+            try: syms[n.strip()]=int(v.strip(),16)
+            except ValueError: pass
+    assert syms['pitch_lut_end'] < syms['apply_init_aliases']
+    assert syms['itvoicegain']==0x6659 and syms['ext_state_end']==0x6671
+    assert syms['it_profile_ptrs']==0x7000 and syms['it_profile_data']==0x7200
+    persisted=(9 + 31 + (syms['cmd1']-syms['period_q']) +
+               (syms['arp1']-syms['vibspd']) + 24 + 168 +
+               (syms['ext_state_end']-syms['itprof']))
+    assert persisted==929 and persisted<=1024
+    assert len(t2k.IT_ENGINE_BIN)==12800
+    assert len(t2k.S3M_ENGINE_BIN)==9054 and len(t2k.IT_S3M_ENGINE_BIN)==8926
+    assert len(t2k.MOD_ENGINE_BIN)==10674 and len(t2k.XM_ENGINE_BIN)==6472
+
