+LIN_P0          equ EV_PERIOD          ; scratch words 05F14h..05F1Bh
+LIN_P1          equ EV_PLO
+LIN_P2          equ EV_DVOL
+LIN_P3          equ EV_TOKEN
+LIN_PARAM       equ EV_NOTE_PRESENT     ; preserve original slide param outside multiply scratch
