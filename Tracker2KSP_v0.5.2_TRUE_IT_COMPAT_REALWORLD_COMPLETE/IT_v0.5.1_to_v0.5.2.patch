+#!/usr/bin/env python3
+from pathlib import Path
+import math, struct, sys
+ROOT=Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(ROOT/'source'))
+sys.path.insert(1,str(ROOT/'tests'))
+import module_formats as mf
+import compact_stream as cs
+import tracker2ksp as t2k
+from test_it_v049 import make_it_samplemode, make_it_instrumentmode
+
+INS_PTR=0xD8; SMP_PTR=0x320; PAT_PTR=0x380
+
+def _patch_first_fx(path:Path, cmd:int, param:int):
+    b=bytearray(path.read_bytes())
+    # Instrument-mode fixture first cell: marker, mask, note, ins, row end...
+    # Replace / extend it with effect data using mask bit 8.
+    plen,rows=struct.unpack_from('<HH',b,PAT_PTR)
+    pdata=bytearray(b[PAT_PTR+8:PAT_PTR+8+plen])
+    # marker=81, mask=03 -> 0B, then note,ins,cmd,param
+    assert pdata[:2]==bytes((0x81,0x03))
+    new=bytes((0x81,0x0B,pdata[2],pdata[3],cmd,param,0,0,0))
+    struct.pack_into('<HHI',b,PAT_PTR,len(new),rows,0)
+    b[PAT_PTR+8:PAT_PTR+8+len(new)]=new
+    path.write_bytes(b)
+
+def _patch_samplemode_fx(path:Path, cmd:int, param:int):
+    b=bytearray(path.read_bytes())
+    b[0x130+8+5]=cmd; b[0x130+8+6]=param
+    b[0x130+8+9]=0x70
+    path.write_bytes(b)
+
+def _patch_it_defaults(path:Path, *, pps=0,ppc=48,igv=128,ipan=0x80,sgv=64,span=0):
+    b=bytearray(path.read_bytes())
+    b[INS_PTR+0x16]=pps&0xFF; b[INS_PTR+0x17]=ppc&0xFF
+    b[INS_PTR+0x18]=igv&0xFF; b[INS_PTR+0x19]=ipan&0xFF
+    b[SMP_PTR+0x11]=sgv&0xFF; b[SMP_PTR+0x2F]=span&0xFF
+    path.write_bytes(b)
+
+def _map_note(path:Path, pattern_note:int, mapped_note:int):
+    b=bytearray(path.read_bytes())
+    # first packed raw IT note is at pattern data +2
+    b[PAT_PTR+8+2]=pattern_note
+    b[INS_PTR+0x40+pattern_note*2]=mapped_note
+    b[INS_PTR+0x41+pattern_note*2]=1
+    path.write_bytes(b)
+
+
+def test_it_v052_linear_factor_pairs_and_stream_commands(tmp_path):
+    assert cs._it_linear_factor_pair(0xE0)==(0,1)  # historical table begins 65535
+    assert cs._it_linear_factor_pair(0xEF)[1]==65536-64645
+    up,down=cs._it_linear_factor_pair(1)
+    assert up==round(65536*(2**(1/192))-65536)
+    assert down==round(65536-65536*(2**(-1/192)))
+    for cmd,outcmd in ((cs.CMD_E,cs.CMD_IT_LINEAR_E),(cs.CMD_F,cs.CMD_IT_LINEAR_F),(cs.CMD_G,cs.CMD_IT_LINEAR_G)):
+        p=tmp_path/f'lin{cmd}.it'; make_it_samplemode(p); b=bytearray(p.read_bytes())
+        flags=struct.unpack_from('<H',b,0x2C)[0] | 0x08; struct.pack_into('<H',b,0x2C,flags)
+        p.write_bytes(b); _patch_samplemode_fx(p,cmd,0x12)
+        m,fmt=mf.parse_module(p); assert fmt=='IT' and m.it_linear_slides
+        cc=cs.CompactCompiler(m,fmt); a=cc._event_action(m.patterns[0][0][0],cc.states[0])
+        fx=[x for x in a.effects if x[0]==outcmd]
+        assert fx and fx[0][2]==cs._it_linear_factor_pair(0x12)
+        enc=cc._encode_action(a)
+        assert struct.pack('<HH',*fx[0][2]) in enc
+
+
+def test_it_v052_s5_panbrello_waveforms_and_sample_hold_runtime(tmp_path):
+    p=tmp_path/'s5.it'; make_it_samplemode(p)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt)
+    for w in range(4):
+        a=cc._event_action(mf.core.Event(0,cmd=cs.CMD_S,param=0x50|w),cs.ResolveState())
+        assert a.effects==[(cs.CMD_IT_PAN_WAVE,w,None)]
+    assert cc._event_action(mf.core.Event(0,cmd=cs.CMD_S,param=0x54),cs.ResolveState()) is None
+    asm=(ROOT/'source'/'compact_engine_it.asm').read_text()
+    assert 'PANBRTYPE       equ GLISS' in asm
+    blk=asm.split('it_y_random_hold:',1)[1].split('it_y_scale:',1)[0]
+    assert 'keep prior PANBROFF' in blk and 'it_y_random_sample:' in blk
+    assert 'cp d' in blk and 'ret' in blk
+
+
+def test_it_v052_instrument_sample_pan_pps_and_sv_iv(tmp_path):
+    p=tmp_path/'defaults.it'; make_it_instrumentmode(p)
+    # Instrument pan=16 is deliberately overridden by sample pan=48. Original
+    # note 60 with PPS +8 and centre 48 adds +48 internal pan units.
+    _patch_it_defaults(p,pps=8,ppc=48,igv=64,ipan=16,sgv=32,span=0x80|48)
+    _map_note(p,60,48)  # prove PPS uses original note, not translated note
+    m,fmt=mf.parse_module(p); assert fmt=='IT'
+    cc=cs.CompactCompiler(m,fmt); e=m.patterns[0][0][0]
+    assert cc._note_index(e.note)==60
+    pan,reset,gain=cc._it_note_pan_gain(1,1,60,128)
+    assert reset and pan==239 and gain==16
+    a=cc._event_action(e,cc.states[0])
+    assert (cs.CMD_IT_GAIN,16,None) in a.effects
+    assert (cs.CMD_X,239,None) in a.effects
+    assert cc.states[0].it_pan_tracker==239
+
+
+def test_it_v052_sample_pan_overrides_instrument_but_row_pan_wins(tmp_path):
+    p=tmp_path/'panprecedence.it'; make_it_instrumentmode(p)
+    _patch_it_defaults(p,ipan=8,span=0x80|48)
+    _patch_first_fx(p,cs.CMD_X,64)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt); e=m.patterns[0][0][0]
+    a=cc._event_action(e,cc.states[0])
+    pans=[ep for ec,ep,_ in a.effects if ec==cs.CMD_X]
+    assert len(pans)>=2 and pans[-1]==64
+    assert pans[0] in (191,192)  # 48/64 mapped to tracker 0..255
+    assert cc.states[0].it_pan_tracker==64
+
+
+def test_it_v052_sample_mode_global_volume_gets_per_voice_gain(tmp_path):
+    p=tmp_path/'samplegain.it'; make_it_samplemode(p)
+    # Sample header in sample-mode fixture starts at 0xD0.
+    b=bytearray(p.read_bytes()); b[0xD0+0x11]=20; p.write_bytes(b)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt)
+    a=cc._event_action(m.patterns[0][0][0],cc.states[0])
+    assert (cs.CMD_IT_GAIN,20,None) in a.effects
+
+
+def test_it_v052_delayed_nonneutral_trigger_state_fails_fast(tmp_path):
+    p=tmp_path/'delay.it'; make_it_instrumentmode(p); _patch_it_defaults(p,sgv=32)
+    m,fmt=mf.parse_module(p); cc=cs.CompactCompiler(m,fmt)
+    e=m.patterns[0][0][0]; e.cmd=cs.CMD_S; e.param=0xD2
+    try: cc._event_action(e,cc.states[0])
+    except ValueError as exc: assert 'delayed note' in str(exc) and 'SV*IV' in str(exc)
+    else: raise AssertionError('non-neutral delayed IT trigger state must not be applied two ticks early')
+
+
+def test_it_v052_filter_envelope_file_flag_80_is_rejected(tmp_path):
+    p=tmp_path/'filter.it'; make_it_instrumentmode(p); b=bytearray(p.read_bytes())
+    b[INS_PTR+0x1D4]=0x81; b[INS_PTR+0x1D5]=1
+    b[INS_PTR+0x1D4+6]=0; struct.pack_into('<H',b,INS_PTR+0x1D4+7,0)
+    p.write_bytes(b)
+    try: mf.parse_module(p)
+    except ValueError as exc: assert 'filter envelope' in str(exc)
+    else: raise AssertionError('IT file flag 0x80 pitch/filter envelope must remain fail-fast')
+
